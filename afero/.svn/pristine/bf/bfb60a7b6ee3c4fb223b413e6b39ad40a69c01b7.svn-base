<%@page import ="afero.model.Colaborador" %>
<%@page import ="afero.persistence.ColaboradorDAO" %>
<%@ page import="java.util.List" %>
<%@ page import="java.util.Iterator" %>
<%
ColaboradorDAO daoEntregador;
List listEntregador;
daoEntregador = new ColaboradorDAO(conn);
String clausulaEntregador = "  WHERE status='A' ORDER BY apelido";
listEntregador = daoEntregador.listarColaborador(clausulaEntregador);
Iterator itEntregador = listEntregador.iterator();
while (itEntregador.hasNext()) { 
	Colaborador entregador = (Colaborador) itEntregador.next();
%>

<option value="<%=entregador.getIdColaborador()%>"><%=entregador.getApelido()%></option>
<%
}
%>