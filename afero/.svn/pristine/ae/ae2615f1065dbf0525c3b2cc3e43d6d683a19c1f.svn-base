package afero.model;

public class OrcamentoEmpresa {
	private int idOrcamentoEmpresa = 0;
	private String nmOrcamentoEmpresa = "";
	private String status = "";
	
	public OrcamentoEmpresa(int idOrcamentoEmpresa, String nmOrcamentoEmpresa, String status){
		this.idOrcamentoEmpresa = idOrcamentoEmpresa;
		this.nmOrcamentoEmpresa = nmOrcamentoEmpresa;
		this.status = status;
	}

	public OrcamentoEmpresa(){}

	public int getIdOrcamentoEmpresa(){
		return this.idOrcamentoEmpresa;
	}
	
	public String getNmOrcamentoEmpresa(){
		return this.nmOrcamentoEmpresa;
	}
	
	public String getStatus(){
		return this.status;
	}
	
	public void setIdOrcamentoEmpresa(int idOrcamentoEmpresa){
		this.idOrcamentoEmpresa = idOrcamentoEmpresa;
	}
	
	public void setNmOrcamentoEmpresa(String nmOrcamentoEmpresa){
		this.nmOrcamentoEmpresa = nmOrcamentoEmpresa;
	}
	
	public void setStatus(String status){
		this.status = status;
	}

}
