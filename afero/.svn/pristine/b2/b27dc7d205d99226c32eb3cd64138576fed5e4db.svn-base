package afero.model;

public class TipoLogradouro {

	private int cdTipoLogradouro;
	private String abrevTipoLogradouro;
	private String dsTipoLogradouro;
	private String status;

	public TipoLogradouro() {

	}

	public TipoLogradouro(int cdTipoLogradouro, String abrevTipoLogradouro,
			String dsTipoLogradouro, String status) {
		this.cdTipoLogradouro = cdTipoLogradouro;
		this.abrevTipoLogradouro = abrevTipoLogradouro;
		this.dsTipoLogradouro = dsTipoLogradouro;
		this.status = status;
	}

	public final int getCdTipoLogradouro() {
		return cdTipoLogradouro;
	}

	public final void setCdTipoLogradouro(int cdTipoLogradouro) {
		this.cdTipoLogradouro = cdTipoLogradouro;
	}

	public final String getAbrevTipoLogradouro() {
		return abrevTipoLogradouro;
	}

	public final void setAbrevTipoLogradouro(String abrevTipoLogradouro) {
		this.abrevTipoLogradouro = abrevTipoLogradouro;
	}

	public final String getDsTipoLogradouro() {
		return dsTipoLogradouro;
	}

	public final void setDsTipoLogradouro(String dsTipoLogradouro) {
		this.dsTipoLogradouro = dsTipoLogradouro;
	}

	public final String getStatus() {
		return status;
	}

	public final void setStatus(String status) {
		this.status = status;
	}
	
}
