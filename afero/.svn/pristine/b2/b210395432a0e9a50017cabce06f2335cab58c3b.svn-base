				<textElement>
					<font fontName="Arial"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{nroTelefone}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="333" y="40" width="100" height="20"/>
				<textElement>
					<font fontName="Arial" isBold="true"/>
				</textElement>
				<text><![CDATA[Prazo de Validade:]]></text>
			</staticText>
			<textField>
				<reportElement x="433" y="40" width="100" height="20"/>
				<textElement>
					<font fontName="Arial"/>
				</textElement>
				<textFieldExpression class="java.lang.Integer"><![CDATA[$F{prazoValidade}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="353" y="60" width="100" height="20"/>
				<textElement>
					<font fontName="Arial" isBold="true"/>
