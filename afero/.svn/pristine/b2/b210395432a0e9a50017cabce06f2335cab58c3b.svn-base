				<textElement>
					<font fontName="Arial" isBold="true"/>
				</textElement>
				<text><![CDATA[Observação:]]></text>
			</staticText>
			<textField>
				<reportElement x="76" y="80" width="479" height="31"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{observacao}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="111" width="42" height="20"/>
				<textElement>
