package afero.model;

public class TipoAtendimento {
	
	private int cdTipoAtendimento;
	private String dsTipoAtendimento;
	private String status;

	public TipoAtendimento() {
	}
	

	public TipoAtendimento(int cdTipoAtendimento, String dsTipoAtendimento,
			String status) {
		super();
		this.cdTipoAtendimento = cdTipoAtendimento;
		this.dsTipoAtendimento = dsTipoAtendimento;
		this.status = status;
	}



	public int getCdTipoAtendimento() {
		return cdTipoAtendimento;
	}

	public void setCdTipoAtendimento(int cdTipoAtendimento) {
		this.cdTipoAtendimento = cdTipoAtendimento;
	}

	public String getDsTipoAtendimento() {
		return dsTipoAtendimento;
	}

	public void setDsTipoAtendimento(String dsTipoAtendimento) {
		this.dsTipoAtendimento = dsTipoAtendimento;
	}

	public String getStatus() {
		return status;
	}

	public void setStatus(String status) {
		this.status = status;
	}
	
	

}
