    		  	if(produto.getCdCfopSaidaDentro() > 0){
    		  		
    		  		if(produto.getCdCfopSaidaDentro()<=4){
    		  			produtos.setCFOP(Utilitaria.soNumeros("".valueOf(produto.getCdCfopSaidaDentro()))); 
    	     		  	}else{
    	     		  		produtos.setCFOP(Utilitaria.soNumeros("".valueOf(produto.getCdCfopSaidaDentro())));
    	     		 	 }
    		  	}
    		  	Estoque estoque = new Estoque();
    		  	EstoqueDAO daoEstoque = new EstoqueDAO(conn);
    		  	estoque = daoEstoque.procurarEstoqueLojaProduto(loja.getIdLoja(), produto.getIdProduto());
    		  	Preco preco = new Preco();
    		  	PrecoDAO daoPreco = new PrecoDAO(conn);
    		  	preco = daoPreco.procurarPrecoEstoqueLoja(estoque.getIdEstoque(), loja.getIdLoja());
    		  	Unidade unidade = new Unidade();
    		  	UnidadeDAO daoUnidade = new UnidadeDAO(conn);
    		  	unidade = daoUnidade.procurarUnidade(preco.getIdUnidade());
    		  	
	if(unidade.getDsUnidade() != null){
    		  		if(unidade.getDsUnidade() .length()<=6){
    		  			produtos.setuCom(unidade.getDsUnidade()); 
    	     		  	}else{
    	     		  		produtos.setuCom((Utilitaria.abreviarStr(unidade.getDsUnidade() , 6)));
    	     		 	 }
    		  	}
	produtos.setEXTIPI("");
	produtos.setcEAN("".valueOf(produto.getIdProduto()));
    		  	produtos.setqCom("".valueOf(itemPedidoSaida.getQuant()));
    		  	produtos.setvUnCom("".valueOf(itemPedidoSaida.getVlUni()));
    		  	produtos.setvProd("".valueOf(itemPedidoSaida.getVlUni()));
    		  	produtos.setcEANTrib("");
    		  	if(unidade.getDsUnidade() != null){
    		  		if(unidade.getDsUnidade() .length()<=6){
    		  			produtos.setuTrib(unidade.getDsUnidade()); 
    	     		  	}else{
    	     		  		produtos.setuTrib((Utilitaria.abreviarStr(unidade.getDsUnidade() , 6)));
    	     		 	 }
    		  	}
    		  	produtos.setqTrib("".valueOf(itemPedidoSaida.getQuant()));
    		  	
    		  	float vUnTrib = (itemPedidoSaida.getVlUni()/itemPedidoSaida.getQuant());
    		  	produtos.setvUnTrib("".valueOf(vUnTrib));
    		  	//Frete
    		  	PedidoSaida pedidoSaida = new PedidoSaida();
    		  	PedidoSaidaDAO daoPedidoSaida = new PedidoSaidaDAO(conn);
    		  	pedidoSaida = daoPedidoSaida.procurarPedidoSaida(Integer.parseInt(idPedidoSaida));
    		  	Entrega entrega = new Entrega();
    		  	EntregaDAO daoEntrega = new EntregaDAO(conn);
    		  	entrega = daoEntrega.procurarEntrega(pedidoSaida.getIdEntrega());
    		  	produtos.setvFrete("".valueOf(entrega.getTxEntrega()));
    		  	//Frete
    		  	produtos.setvSeg("0");
    		  	produtos.setvDesc("".valueOf(itemPedidoSaida.getpDesc()));
    		  	produtos.setvOutro("");
    		  	produtos.setIndTot("1");
    		  	//Verificar isso depois
    		  	produtos.setNVE("");
    		  	listProdutos.add(produtos);
    		  	Det det = new Det();
    		  	det.setDet(listProdutos);
    	           	
    		  }
    	  }
%>
