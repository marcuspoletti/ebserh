package afero.model;
import java.util.*;
public class Duplicata {
	
	
	private int idDuplicata = 0;
	private int idLoja = 0;
	private int cdEntidade = 0;
	private String dc = "";
	private Date dtEmissao = null;
	private Date dtComp = null;
	private String nrDoc = "";
	private int idTipoDocumento = 0;
	private int idPlanoConta = 0;
	private int idCentroCusto = 0;
	private String historico = "";
	private int nrDiasPag = 0;
	private int quantParcelas = 0;
	private double valorTotal = 0;
	private String gerarBoleto = "";
	private String observacao = "";
	private String tipoLancamento = "";
	private float txMulta = 0;
	private float txJuros = 0;
	private String tipoJuros = "";
	private String status = "";
	private Date dtCad = null;
	private Date dtMod = null;
	private String usuario = "";
	
	public Duplicata() {
		
	}

	public Duplicata(int idDuplicata, int idLoja, int cdEntidade, String dc,
			Date dtEmissao, Date dtComp, String nrDoc, int idTipoDocumento,
			int idPlanoConta, int idCentroCusto, String historico,
			int nrDiasPag, int quantParcelas, double valorTotal,
			String gerarBoleto, String observacao, String tipoLancamento,
			float txMulta, float txJuros, String tipoJuros, String status,
			Date dtCad, Date dtMod, String usuario) {
		
		this.idDuplicata = idDuplicata;
		this.idLoja = idLoja;
		this.cdEntidade = cdEntidade;
		this.dc = dc;
		this.dtEmissao = dtEmissao;
		this.dtComp = dtComp;
		this.nrDoc = nrDoc;
		this.idTipoDocumento = idTipoDocumento;
		this.idPlanoConta = idPlanoConta;
		this.idCentroCusto = idCentroCusto;
		this.historico = historico;
		this.nrDiasPag = nrDiasPag;
		this.quantParcelas = quantParcelas;
		this.valorTotal = valorTotal;
		this.gerarBoleto = gerarBoleto;
		this.observacao = observacao;
		this.tipoLancamento = tipoLancamento;
		this.txMulta = txMulta;
		this.txJuros = txJuros;
		this.tipoJuros = tipoJuros;
		this.status = status;
		this.dtCad = dtCad;
		this.dtMod = dtMod;
		this.usuario = usuario;
	}

	public int getIdDuplicata() {
		return idDuplicata;
	}

	public void setIdDuplicata(int idDuplicata) {
		this.idDuplicata = idDuplicata;
	}

	public int getIdLoja() {
		return idLoja;
	}

	public void setIdLoja(int idLoja) {
		this.idLoja = idLoja;
	}

	public int getCdEntidade() {
		return cdEntidade;
	}

	public void setCdEntidade(int cdEntidade) {
		this.cdEntidade = cdEntidade;
	}

	public String getDc() {
		return dc;
	}

	public void setDc(String dc) {
		this.dc = dc;
	}

	public Date getDtEmissao() {
		return dtEmissao;
	}

	public void setDtEmissao(Date dtEmissao) {
		this.dtEmissao = dtEmissao;
	}

	public Date getDtComp() {
		return dtComp;
	}

	public void setDtComp(Date dtComp) {
		this.dtComp = dtComp;
	}

	public String getNrDoc() {
		return nrDoc;
	}

	public void setNrDoc(String nrDoc) {
		this.nrDoc = nrDoc;
	}

	public int getIdTipoDocumento() {
		return idTipoDocumento;
	}

	public void setIdTipoDocumento(int idTipoDocumento) {
		this.idTipoDocumento = idTipoDocumento;
	}

	public int getIdPlanoConta() {
		return idPlanoConta;
	}

	public void setIdPlanoConta(int idPlanoConta) {
		this.idPlanoConta = idPlanoConta;
	}

	public int getIdCentroCusto() {
		return idCentroCusto;
	}

	public void setIdCentroCusto(int idCentroCusto) {
		this.idCentroCusto = idCentroCusto;
	}

	public String getHistorico() {
		return historico;
	}

	public void setHistorico(String historico) {
		this.historico = historico;
	}

	public int getNrDiasPag() {
		return nrDiasPag;
	}

	public void setNrDiasPag(int nrDiasPag) {
		this.nrDiasPag = nrDiasPag;
	}

	public int getQuantParcelas() {
		return quantParcelas;
	}

	public void setQuantParcelas(int quantParcelas) {
		this.quantParcelas = quantParcelas;
	}

	public double getValorTotal() {
		return valorTotal;
	}

	public void setValorTotal(double valorTotal) {
		this.valorTotal = valorTotal;
	}

	public String getGerarBoleto() {
		return gerarBoleto;
	}

	public void setGerarBoleto(String gerarBoleto) {
		this.gerarBoleto = gerarBoleto;
	}

	public String getObservacao() {
		return observacao;
	}

	public void setObservacao(String observacao) {
		this.observacao = observacao;
	}

	public String getTipoLancamento() {
		return tipoLancamento;
	}

	public void setTipoLancamento(String tipoLancamento) {
		this.tipoLancamento = tipoLancamento;
	}

	public float getTxMulta() {
		return txMulta;
	}

	public void setTxMulta(float txMulta) {
		this.txMulta = txMulta;
	}

	public float getTxJuros() {
		return txJuros;
	}

	public void setTxJuros(float txJuros) {
		this.txJuros = txJuros;
	}

	public String getTipoJuros() {
		return tipoJuros;
	}

	public void setTipoJuros(String tipoJuros) {
		this.tipoJuros = tipoJuros;
	}

	public String getStatus() {
		return status;
	}

	public void setStatus(String status) {
		this.status = status;
	}

	public Date getDtCad() {
		return dtCad;
	}

	public void setDtCad(Date dtCad) {
		this.dtCad = dtCad;
	}

	public Date getDtMod() {
		return dtMod;
	}

	public void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}

	public String getUsuario() {
		return usuario;
	}

	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}
	

	


}
