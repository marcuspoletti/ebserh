package afero.model;

public class RelatorioMesAnual {

	private String dc = "";
	private float valor = 0;
	private int mes = 0;

	public RelatorioMesAnual() {
	}

	public RelatorioMesAnual(String dc, float valor, int mes) {
		this.dc = dc;
		this.valor = valor;
		this.mes = mes;
	}

	public String getDc() {
		return dc;
	}

	public void setDc(String dc) {
		this.dc = dc;
	}

	public float getValor() {
		return valor;
	}

	public void setValor(float valor) {
		this.valor = valor;
	}

	public int getMes() {
		return mes;
	}

	public void setMes(int mes) {
		this.mes = mes;
	}

}
