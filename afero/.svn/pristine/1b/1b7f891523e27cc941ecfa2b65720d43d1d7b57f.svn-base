package afero.model;

public class ConfigServico {
	
	private int idLoja;
	private String tipoOS;
	private String dsCampo1;
	private String dsCampo2;
	private String dsCampo3;
	private String dsCampo4;
	private String msg1;
	private String msg2;
	private String msg3;
	private String msg4;
	private String msg5;
	private float pCSocial;
	private float pCofins;
	private float pPis;
	private float pIrrf;
	private float tetoIrrf;
	private float pInss;
	private float pIss;
	private int cdCfopServico;
	private int cdCfopProduto;
	private String dsCmpOb1;
	private String dsCmpOb2;
	private String dsCmpOb3;
	private String dsCmpOb4;
	
	public ConfigServico() {
	}

	public ConfigServico(int idLoja, String tipoOS, String dsCampo1,
			String dsCampo2, String dsCampo3, String dsCampo4, String msg1,
			String msg2, String msg3, String msg4, String msg5, float pCSocial,
			float pCofins, float pPis, float pIrrf, float tetoIrrf,
			float pInss, float pIss, int cdCfopServico, int cdCfopProduto,
			String dsCmpOb1, String dsCmpOb2, String dsCmpOb3, String dsCmpOb4) {
		super();
		this.idLoja = idLoja;
		this.tipoOS = tipoOS;
		this.dsCampo1 = dsCampo1;
		this.dsCampo2 = dsCampo2;
		this.dsCampo3 = dsCampo3;
		this.dsCampo4 = dsCampo4;
		this.msg1 = msg1;
		this.msg2 = msg2;
		this.msg3 = msg3;
		this.msg4 = msg4;
		this.msg5 = msg5;
		this.pCSocial = pCSocial;
		this.pCofins = pCofins;
		this.pPis = pPis;
		this.pIrrf = pIrrf;
		this.tetoIrrf = tetoIrrf;
		this.pInss = pInss;
		this.pIss = pIss;
		this.cdCfopServico = cdCfopServico;
		this.cdCfopProduto = cdCfopProduto;
		this.dsCmpOb1 = dsCmpOb1;
		this.dsCmpOb2 = dsCmpOb2;
		this.dsCmpOb3 = dsCmpOb3;
		this.dsCmpOb4 = dsCmpOb4;
	}

	public int getIdLoja() {
		return idLoja;
	}

	public void setIdLoja(int idLoja) {
		this.idLoja = idLoja;
	}

	public String getTipoOS() {
		return tipoOS;
	}

	public void setTipoOS(String tipoOS) {
		this.tipoOS = tipoOS;
	}

	public String getDsCampo1() {
		return dsCampo1;
	}

	public void setDsCampo1(String dsCampo1) {
		this.dsCampo1 = dsCampo1;
	}

	public String getDsCampo2() {
		return dsCampo2;
	}

	public void setDsCampo2(String dsCampo2) {
		this.dsCampo2 = dsCampo2;
	}

	public String getDsCampo3() {
		return dsCampo3;
	}

	public void setDsCampo3(String dsCampo3) {
		this.dsCampo3 = dsCampo3;
	}

	public String getDsCampo4() {
		return dsCampo4;
	}

	public void setDsCampo4(String dsCampo4) {
		this.dsCampo4 = dsCampo4;
	}

	public String getMsg1() {
		return msg1;
	}

	public void setMsg1(String msg1) {
		this.msg1 = msg1;
	}

	public String getMsg2() {
		return msg2;
	}

	public void setMsg2(String msg2) {
		this.msg2 = msg2;
	}

	public String getMsg3() {
		return msg3;
	}

	public void setMsg3(String msg3) {
		this.msg3 = msg3;
	}

	public String getMsg4() {
		return msg4;
	}

	public void setMsg4(String msg4) {
		this.msg4 = msg4;
	}

	public String getMsg5() {
		return msg5;
	}

	public void setMsg5(String msg5) {
		this.msg5 = msg5;
	}

	public float getpCSocial() {
		return pCSocial;
	}

	public void setpCSocial(float pCSocial) {
		this.pCSocial = pCSocial;
	}

	public float getpCofins() {
		return pCofins;
	}

	public void setpCofins(float pCofins) {
		this.pCofins = pCofins;
	}

	public float getpPis() {
		return pPis;
	}

	public void setpPis(float pPis) {
		this.pPis = pPis;
	}

	public float getpIrrf() {
		return pIrrf;
	}

	public void setpIrrf(float pIrrf) {
		this.pIrrf = pIrrf;
	}

	public float getTetoIrrf() {
		return tetoIrrf;
	}

	public void setTetoIrrf(float tetoIrrf) {
		this.tetoIrrf = tetoIrrf;
	}

	public float getpInss() {
		return pInss;
	}

	public void setpInss(float pInss) {
		this.pInss = pInss;
	}

	public float getpIss() {
		return pIss;
	}

	public void setpIss(float pIss) {
		this.pIss = pIss;
	}

	public int getCdCfopServico() {
		return cdCfopServico;
	}

	public void setCdCfopServico(int cdCfopServico) {
		this.cdCfopServico = cdCfopServico;
	}

	public int getCdCfopProduto() {
		return cdCfopProduto;
	}

	public void setCdCfopProduto(int cdCfopProduto) {
		this.cdCfopProduto = cdCfopProduto;
	}

	public String getDsCmpOb1() {
		return dsCmpOb1;
	}

	public void setDsCmpOb1(String dsCmpOb1) {
		this.dsCmpOb1 = dsCmpOb1;
	}

	public String getDsCmpOb2() {
		return dsCmpOb2;
	}

	public void setDsCmpOb2(String dsCmpOb2) {
		this.dsCmpOb2 = dsCmpOb2;
	}

	public String getDsCmpOb3() {
		return dsCmpOb3;
	}

	public void setDsCmpOb3(String dsCmpOb3) {
		this.dsCmpOb3 = dsCmpOb3;
	}

	public String getDsCmpOb4() {
		return dsCmpOb4;
	}

	public void setDsCmpOb4(String dsCmpOb4) {
		this.dsCmpOb4 = dsCmpOb4;
	}
	
}