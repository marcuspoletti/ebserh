package afero.model;

public class TipoDependente {
	
	private int idTipoDependente;
	private String dsTipoDependente;
	private String status;
	
	public TipoDependente() {
		
	}
	
    public TipoDependente(int idTipoDependente, String dsTipoDependente, String status){
    	this.dsTipoDependente  = dsTipoDependente;
    	this.idTipoDependente = idTipoDependente;
    	this.status = status;
		
	}
	public final int getIdTipoDependente() {
		return idTipoDependente;
	}
	
	public final void setIdTipoDependente(int idTipoDependente) {
		this.idTipoDependente = idTipoDependente;
	}
	
	public final String getDsTipoDependente() {
		return dsTipoDependente;
	}
	
	public final void setDsTipoDependente(String dsTipoDependente) {
		this.dsTipoDependente = dsTipoDependente;
	}
	
	public final String getStatus() {
		return status;
	}
	
	public final void setStatus(String status) {
		this.status = status;
	}	

}
