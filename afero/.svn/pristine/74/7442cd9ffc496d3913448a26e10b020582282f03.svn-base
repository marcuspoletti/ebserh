package afero.model;

import java.util.Date;

public class OrdemServicoTarefa {
	
	private int idOrdemServicoTarefa;
	private int idOrdemServicoItem;
	private int idListaTarefa;
	private String dsCompTarefa;
	private float quant;
	private float valor;
	private float pDesc;
	private float vlUni;
	private int idColaborador;
	private Date dtMod;
	private String usuario;

	public OrdemServicoTarefa() {
	}
	
	public OrdemServicoTarefa(int idOrdemServicoTarefa, int idOrdemServicoItem,
			int idListaTarefa, String dsCompTarefa, float quant, float valor,
			float pDesc, float vlUni, int idColaborador, Date dtMod,
			String usuario) {
		super();
		this.idOrdemServicoTarefa = idOrdemServicoTarefa;
		this.idOrdemServicoItem = idOrdemServicoItem;
		this.idListaTarefa = idListaTarefa;
		this.dsCompTarefa = dsCompTarefa;
		this.quant = quant;
		this.valor = valor;
		this.pDesc = pDesc;
		this.vlUni = vlUni;
		this.idColaborador = idColaborador;
		this.dtMod = dtMod;
		this.usuario = usuario;
	}



	public int getIdOrdemServicoTarefa() {
		return idOrdemServicoTarefa;
	}

	public void setIdOrdemServicoTarefa(int idOrdemServicoTarefa) {
		this.idOrdemServicoTarefa = idOrdemServicoTarefa;
	}

	public int getIdOrdemServicoItem() {
		return idOrdemServicoItem;
	}

	public void setIdOrdemServicoItem(int idOrdemServicoItem) {
		this.idOrdemServicoItem = idOrdemServicoItem;
	}

	public int getIdListaTarefa() {
		return idListaTarefa;
	}

	public void setIdListaTarefa(int idListaTarefa) {
		this.idListaTarefa = idListaTarefa;
	}

	public String getDsCompTarefa() {
		return dsCompTarefa;
	}

	public void setDsCompTarefa(String dsCompTarefa) {
		this.dsCompTarefa = dsCompTarefa;
	}

	public float getQuant() {
		return quant;
	}

	public void setQuant(float quant) {
		this.quant = quant;
	}

	public float getValor() {
		return valor;
	}

	public void setValor(float valor) {
		this.valor = valor;
	}

	public float getpDesc() {
		return pDesc;
	}

	public void setpDesc(float pDesc) {
		this.pDesc = pDesc;
	}

	public float getVlUni() {
		return vlUni;
	}

	public void setVlUni(float vlUni) {
		this.vlUni = vlUni;
	}

	public int getIdColaborador() {
		return idColaborador;
	}

	public void setIdColaborador(int idColaborador) {
		this.idColaborador = idColaborador;
	}

	public Date getDtMod() {
		return dtMod;
	}

	public void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}

	public String getUsuario() {
		return usuario;
	}

	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}
	
	
	
	

}
