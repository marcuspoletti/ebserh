<%@page import ="afero.model.Colaborador" %>
<%@page import ="afero.persistence.ColaboradorDAO" %>
<%@ page import="java.util.List" %>
<%@ page import="java.util.Iterator" %>
<%
ColaboradorDAO daoVendedor;
List listVendedor;
daoVendedor = new ColaboradorDAO(conn);
String clausulaVendedor = "  WHERE status='A' ORDER BY apelido";
listVendedor = daoVendedor.listarColaborador(clausulaVendedor);
Iterator itVendedor = listVendedor.iterator();
while (itVendedor.hasNext()) { 
	Colaborador vendedor = (Colaborador) itVendedor.next();
%>

<option value="<%=vendedor.getIdColaborador()%>"><%=vendedor.getApelido()%></option>
<%
}
%>