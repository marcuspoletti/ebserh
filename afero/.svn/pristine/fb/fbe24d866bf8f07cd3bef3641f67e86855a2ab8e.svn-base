<%@include file="../seguranca.jsp"%>
<%@page language = "java"%>

<h1 class="cabecalho_pagina">Imp. Arquivo (.CSV)</h1>
<hr>
<body onload="document.forms[0].elements[0].focus();" >
<form enctype ="multipart/form-data" ACTION ="upload_page.jsp" METHOD ="post">
<center>
<table border="2">
  <tr> <center> <td colspan="2" class="grid"> <p align ="Center"> <b> Upload do Arquivo </b> <center> </td></tr> 
  <tr> <td class="grid"> <b> Escolha o arquivo .CSV para upload: </b></td> 
       <td class="grid"> <INPUT name="file" type="file"> </td> </tr> 
       <td colspan="2" class="grid"><p align="right"> <input class="button" type="submit" value="Enviar Arq."> </p> </td> </tr> 
</table>
</center>
</form>
</body>
