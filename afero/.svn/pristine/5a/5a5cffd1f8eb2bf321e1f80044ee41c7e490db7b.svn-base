package afero.model;

public class Escolaridade {

	private int cdEscolaridade;
	private String dsEscolaridade;
	private String status;

	public Escolaridade() {

	}

	public Escolaridade(int cdEscolaridade, String dsEscolaridade, String status) {
		this.cdEscolaridade = cdEscolaridade;
		this.dsEscolaridade = dsEscolaridade;
		this.status = status;
	}

	public final int getCdEscolaridade() {
		return cdEscolaridade;
	}

	public final void setCdEscolaridade(int cdEscolaridade) {
		this.cdEscolaridade = cdEscolaridade;
	}

	public final String getDsEscolaridade() {
		return dsEscolaridade;
	}

	public final void setDsEscolaridade(String dsEscolaridade) {
		this.dsEscolaridade = dsEscolaridade;
	}

	public final String getStatus() {
		return status;
	}

	public final void setStatus(String status) {
		this.status = status;
	}
		
}
