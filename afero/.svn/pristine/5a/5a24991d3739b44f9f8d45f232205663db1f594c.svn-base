package afero.model;

public class TipoEmail {

	private int cdTipoEmail;
	private String dsTipoEmail;
	private String status;
	
	public TipoEmail() {

	}

	public TipoEmail(int cdTipoEmail, String dsTipoEmail, String status) {
		this.cdTipoEmail = cdTipoEmail;
		this.dsTipoEmail = dsTipoEmail;
		this.status = status;
	}

	public final int getCdTipoEmail() {
		return cdTipoEmail;
	}

	public final void setCdTipoEmail(int cdTipoEmail) {
		this.cdTipoEmail = cdTipoEmail;
	}

	public final String getDsTipoEmail() {
		return dsTipoEmail;
	}

	public final void setDsTipoEmail(String dsTipoEmail) {
		this.dsTipoEmail = dsTipoEmail;
	}

	public final String getStatus() {
		return status;
	}

	public final void setStatus(String status) {
		this.status = status;
	}
	
}
