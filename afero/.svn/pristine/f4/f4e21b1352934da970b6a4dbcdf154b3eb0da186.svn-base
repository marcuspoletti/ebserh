package afero.model;

public class VendasGrupos {

	private String dsGrupo = "";
	private float valor = 0;
	private int quantItens = 0;
	private int idGrupo = 0;
	
	
	public VendasGrupos(String dsGrupo, float valor, int quantItens) {
		this.dsGrupo = dsGrupo;
		this.valor = valor;
		this.quantItens = quantItens;
	}
	
	

	public VendasGrupos(String dsGrupo, float valor, int quantItens, int idGrupo) {
		
		this.dsGrupo = dsGrupo;
		this.valor = valor;
		this.quantItens = quantItens;
		this.idGrupo = idGrupo;
	}



	public VendasGrupos() {
		
	}
	
	public int getIdGrupo() {
		return idGrupo;
	}

	public void setIdGrupo(int idGrupo) {
		this.idGrupo = idGrupo;
	}

	public int getQuantItens() {
		return quantItens;
	}
	public void setQuantItens(int quantItens) {
		this.quantItens = quantItens;
	}
	
	public String getDsGrupo() {
		return dsGrupo;
	}
	public void setDsGrupo(String dsGrupo) {
		this.dsGrupo = dsGrupo;
	}
	public float getValor() {
		return valor;
	}
	public void setValor(float valor) {
		this.valor = valor;
	}
	
	
	
	
}
