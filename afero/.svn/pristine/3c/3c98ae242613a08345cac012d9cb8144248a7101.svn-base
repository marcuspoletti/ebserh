<html>
<head>
<%@page contentType="text/html;charset=ISO-8859-1" pageEncoding="ISO-8859-1" %>
<%@page import="afero.model.ListaTarefa" %>
<%@page import="afero.persistence.ListaTarefaDAO" %>
<%@page import="afero.util.ConverteDate" %>
<%@page import="afero.util.Utilitaria" %>
<%@page import="java.util.Date" %>
<%@include file="../seguranca.jsp"%>
<%@include file="../iniConexao.jsp"%>
<link type="text/css" rel="Stylesheet" href="../css/afero.css" />
<script src="../js/common.js"/></script>

<script>
function salvar() {
	if (document.all.idLoja.value == 0) {
		window.alert("O campo Loja é obrigatório.");
		document.all.idLoja.focus();
	}else if (document.all.dsListaTarefa.value == '') {
		window.alert("O campo Descrição do Tarefa é obrigatório.");
		document.all.dsListaTarefa.focus();
	}else if(document.all.idUnidade.value == '0') {
		window.aler("O Campo Unidade é obrigatório.");
		document.all.idUnidade.focus();
	}else {
		document.forms[0].submit();
	}
}

function cancelar() {
  document.forms[0].action="formListaTarefa.jsp";
  document.forms[0].submit();
}

function recarregar(acao) {
  document.forms[0].action='formListaTarefa.jsp?acao='+acao;
  document.forms[0].submit();
}


function voltar() {
  document.forms[0].action = 'listarListaTarefa.jsp?acao=voltar'
	document.forms[0].submit();
}  
</script>
</head>
<%
String acao = request.getParameter("acao");
String idListaTarefa = request.getParameter("idListaTarefa");

if (acao == null) acao = "inc";
if(idListaTarefa == null) idListaTarefa = "0";

int idLoja = 0;
String dsListaTarefa = "";
float preco = 0;
int idUnidade = 0;
String status = "A";
Date dtCad = null;
Date dtMod = null;
String usuario = (String) session.getAttribute("Login");

if (acao.equalsIgnoreCase("atu")){
	
	ListaTarefaDAO dao = new ListaTarefaDAO(conn);
	ListaTarefa listaTarefa = dao.procurarListaTarefa(" WHERE idListaTarefa = "+Integer.parseInt(idListaTarefa));
	
	idLoja = listaTarefa.getIdLoja();
	dsListaTarefa = listaTarefa.getDsListaTarefa();
	preco = listaTarefa.getPreco();
	idUnidade = listaTarefa.getIdUnidade();
	status = listaTarefa.getStatus();
	dtCad = listaTarefa.getDtCad();
	dtMod = listaTarefa.getDtMod();
	usuario = listaTarefa.getUsuario();

	}

%>
<body onload="document.forms[0].elements[2].focus();" >
<h1 class="cabecalho_pagina">Cadastro de Tarefas</h1>
<form method="post" action="listarListaTarefa.jsp?acao=<%=acao%>&idListaTarefa=<%=idListaTarefa%>">
<input type="hidden" name="acao" value="<%=acao%>"/>
<input type="hidden" name="idListaTarefa" value="<%=idListaTarefa%>"/>
<iframe width=174 height=189 name="gToday:normal:"../js/calendar/agenda.js"
            id="gToday:normal:"../js/calendar/agenda.js" src="../js/calendar/ipopeng.htm"
            scrolling="no" frameborder="0" style="visibility:visible; z-index:999; 
    position:absolute; top:-500px; left:-500px;">
</iframe>

<table border="0" width="100%">
   <tr>
      <th class="label">Loja*</th>
      <td><select name="idLoja" required="true">
          <option value='0'>Selecione...</option>
          <%@include file="../WEB-INF/jspf/combo/comboLoja.jspf"%></select>
          <script>comboSelect(document.forms[0].idLoja, '<%= idLoja %>');</script>
      </td>
  </tr>
	<tr>
		<th class="label">Descrição*</th>
		<td><textarea  id="dsListaTarefa" name="dsListaTarefa" cols="50" rows="5" maxlength="100"><%=dsListaTarefa%></textarea></td>
	</tr>
	<tr>
		<th class="label">Preço</th>
		<td><input type="text" id="preco" name="preco" onkeyup="FormataValor(this,event)" size="10" maxlength="10" value="<%=preco %>"/></td>
	</tr>
	<tr>
		<th class="label">Unidade</th>
			<td><select name="idUnidade" required="true">
			<option value='0'>Selecione...</option>
			<%@include file="../WEB-INF/jspf/combo/comboUnidade.jspf"%></select>
			<script>comboSelect(document.forms[0].idUnidade,'<%= idUnidade%>');</script>
		</td>
	</tr>
	</tr>
	<tr>
		<th class="label">Status</th>
		<td class="label_radio">
			<input type="radio" class="radio" name="status" value="A" <%= (status.equals("A")? "checked": "") %>>Ativo
			<input type="radio" class="radio" name="status" value="I" <%= (status.equals("I")? "checked": "") %>>Inativo
		</td>
	</tr>
  <%
    if(acao.equalsIgnoreCase("atu")){
   %>
     	<tr>
  	    <th class="label">Registros:</th>
   	 	<td class="label_menor"><center>&nbsp Registro: <%if (dtCad != null) { %><%=dtCad%><% }%>&nbsp;</center></td>
   	 	<td class="label_menor"><center>&nbsp Modificação: <%if (dtMod != null) { %><%=dtMod%><% }%>&nbsp;</center></td>
   	 	<td class="label_menor"><center>&nbsp Usuário: <%if (usuario != null) { %><%=usuario%><% }%>&nbsp;</center></td>
  	    
	</tr>
  <%
    }
  %>  
</table><hr>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
	<tr>
		<td>
			<input class="button" type="button" value="Salvar" onClick="javascript: salvar();" />
			<input class="button" type="button" value="Cancelar" onClick="javascript: cancelar();" />
			<input class="button" type="button" value="Voltar" onClick="javascript: voltar();" />
		</td>
		<td class="campo_obrigatorio">* Campos Obrigatórios</td>
	</tr>
</table>
</form>
<%@include file="../fimConexao.jsp"%>
</body>
</html>