package afero.model;

public class RelatorioMeses {

	private String dc = "";
	private float valor = 0;
	private int mes = 0;
	private int planoConta = 0;

	public RelatorioMeses() {
	}

	public RelatorioMeses(String dc, float valor, int mes, int planoConta) {
		this.dc = dc;
		this.valor = valor;
		this.mes = mes;
		this.planoConta = planoConta;
	}

	public int getPlanoConta() {
		return planoConta;
	}

	public void setPlanoConta(int planoConta) {
		this.planoConta = planoConta;
	}

	public String getDc() {
		return dc;
	}

	public void setDc(String dc) {
		this.dc = dc;
	}

	public float getValor() {
		return valor;
	}

	public void setValor(float valor) {
		this.valor = valor;
	}

	public int getMes() {
		return mes;
	}

	public void setMes(int mes) {
		this.mes = mes;
	}

}
