package aferopet.model;
import java.util.Date;

public class Medicamento {
	
	private int idMedicamento;
	private int idGrupoMedicamento;
	private String nmMedicamento;
	private String principioAtivo;
	private String apresentacao;
	private String dosePAtivo;
	private String doseApresentacao;
	private String uso;
	private String indicacao;
	private String fabricante;
	private String observacao;
	private int idProduto;
	private String status;
	private Date dtCad;
	private Date dtMod;
	private String usuario;
	
	public Medicamento() {
	}

	public Medicamento(int idMedicamento, int idGrupoMedicamento,
			String nmMedicamento, String principioAtivo, String apresentacao,
			String dosePAtivo, String doseApresentacao, String uso,
			String indicacao, String fabricante, String observacao,
			int idProduto, String status, Date dtCad, Date dtMod, String usuario) {
		super();
		this.idMedicamento = idMedicamento;
		this.idGrupoMedicamento = idGrupoMedicamento;
		this.nmMedicamento = nmMedicamento;
		this.principioAtivo = principioAtivo;
		this.apresentacao = apresentacao;
		this.dosePAtivo = dosePAtivo;
		this.doseApresentacao = doseApresentacao;
		this.uso = uso;
		this.indicacao = indicacao;
		this.fabricante = fabricante;
		this.observacao = observacao;
		this.idProduto = idProduto;
		this.status = status;
		this.dtCad = dtCad;
		this.dtMod = dtMod;
		this.usuario = usuario;
	}

	public int getIdMedicamento() {
		return idMedicamento;
	}

	public void setIdMedicamento(int idMedicamento) {
		this.idMedicamento = idMedicamento;
	}

	public int getIdGrupoMedicamento() {
		return idGrupoMedicamento;
	}

	public void setIdGrupoMedicamento(int idGrupoMedicamento) {
		this.idGrupoMedicamento = idGrupoMedicamento;
	}

	public String getNmMedicamento() {
		return nmMedicamento;
	}

	public void setNmMedicamento(String nmMedicamento) {
		this.nmMedicamento = nmMedicamento;
	}

	public String getPrincipioAtivo() {
		return principioAtivo;
	}

	public void setPrincipioAtivo(String principioAtivo) {
		this.principioAtivo = principioAtivo;
	}

	public String getApresentacao() {
		return apresentacao;
	}

	public void setApresentacao(String apresentacao) {
		this.apresentacao = apresentacao;
	}

	public String getDosePAtivo() {
		return dosePAtivo;
	}

	public void setDosePAtivo(String dosePAtivo) {
		this.dosePAtivo = dosePAtivo;
	}

	public String getDoseApresentacao() {
		return doseApresentacao;
	}

	public void setDoseApresentacao(String doseApresentacao) {
		this.doseApresentacao = doseApresentacao;
	}

	public String getUso() {
		return uso;
	}

	public void setUso(String uso) {
		this.uso = uso;
	}

	public String getIndicacao() {
		return indicacao;
	}

	public void setIndicacao(String indicacao) {
		this.indicacao = indicacao;
	}

	public String getFabricante() {
		return fabricante;
	}

	public void setFabricante(String fabricante) {
		this.fabricante = fabricante;
	}

	public String getObservacao() {
		return observacao;
	}

	public void setObservacao(String observacao) {
		this.observacao = observacao;
	}

	public int getIdProduto() {
		return idProduto;
	}

	public void setIdProduto(int idProduto) {
		this.idProduto = idProduto;
	}

	public String getStatus() {
		return status;
	}

	public void setStatus(String status) {
		this.status = status;
	}

	public Date getDtCad() {
		return dtCad;
	}

	public void setDtCad(Date dtCad) {
		this.dtCad = dtCad;
	}

	public Date getDtMod() {
		return dtMod;
	}

	public void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}

	public String getUsuario() {
		return usuario;
	}

	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}

}
