package afero.model;

import java.util.Date;

public class RelatorioOrcamentoCliente {
	int idOrcamento = 0;
	String nome = "";
	Date dtEntrega;
	String dsEntrega = "";
	String pessoaResponsavel = "";
	int prazoValidade = 0;
	String observacao = "";
    String status = "";
    String nroTelefone = "";
    
    
	public RelatorioOrcamentoCliente() {
		
	}


	public RelatorioOrcamentoCliente(int idOrcamento, String nome,
			Date dtEntrega, String dsEntrega, String pessoaResponsavel,
			int prazoValidade, String observacao, String status,
			String nroTelefone) {
	
		this.idOrcamento = idOrcamento;
		this.nome = nome;
		this.dtEntrega = dtEntrega;
		this.dsEntrega = dsEntrega;
		this.pessoaResponsavel = pessoaResponsavel;
		this.prazoValidade = prazoValidade;
		this.observacao = observacao;
		this.status = status;
		this.nroTelefone = nroTelefone;
	}


	public int getIdOrcamento() {
		return idOrcamento;
	}


	public void setIdOrcamento(int idOrcamento) {
		this.idOrcamento = idOrcamento;
	}


	public String getNome() {
		return nome;
	}


	public void setNome(String nome) {
		this.nome = nome;
	}


	public Date getDtEntrega() {
		return dtEntrega;
	}


	public void setDtEntrega(Date dtEntrega) {
		this.dtEntrega = dtEntrega;
	}


	public String getDsEntrega() {
		return dsEntrega;
	}


	public void setDsEntrega(String dsEntrega) {
		this.dsEntrega = dsEntrega;
	}


	public String getPessoaResponsavel() {
		return pessoaResponsavel;
	}


	public void setPessoaResponsavel(String pessoaResponsavel) {
		this.pessoaResponsavel = pessoaResponsavel;
	}


	public int getPrazoValidade() {
		return prazoValidade;
	}


	public void setPrazoValidade(int prazoValidade) {
		this.prazoValidade = prazoValidade;
	}


	public String getObservacao() {
		return observacao;
	}


	public void setObservacao(String observacao) {
		this.observacao = observacao;
	}


	public String getStatus() {
		return status;
	}


	public void setStatus(String status) {
		this.status = status;
	}


	public String getNroTelefone() {
		return nroTelefone;
	}


	public void setNroTelefone(String nroTelefone) {
		this.nroTelefone = nroTelefone;
	}


}
