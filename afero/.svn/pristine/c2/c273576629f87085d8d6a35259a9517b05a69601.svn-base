package afero.model;

public class CotacaoPedidoEntrada {
	
	private int idCotacao;
	private int idPedidoEntrada;
	
	
	public CotacaoPedidoEntrada(){}
	
	public CotacaoPedidoEntrada(int idCotacao, int idPedidoEntrada) {
		this.idCotacao = idCotacao;
		this.idPedidoEntrada = idPedidoEntrada;
	}

	public int getIdCotacao() {
		return idCotacao;
	}
	
	public void setIdCotacao(int idCotacao) {
		this.idCotacao = idCotacao;
	}
	
	public int getIdPedidoEntrada() {
		return idPedidoEntrada;
	}
	
	public void setIdPedidoEntrada(int idPedidoEntrada) {
		this.idPedidoEntrada = idPedidoEntrada;
	}

}
