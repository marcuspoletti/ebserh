<%@ page contentType="text/html;charset=ISO-8859-1" pageEncoding="ISO-8859-1" %>
<%@ page import="afero.model.Produto" %>
<%@ page import="afero.model.Unidade" %>
<%@ page import="afero.model.Estoque" %>
<%@ page import="afero.model.Preco" %>
<%@page import="afero.model.OrcamentoItem"%>
<%@ page import="afero.model.Loja" %>
<%@ page import="afero.persistence.ProdutoDAO" %>
<%@ page import="afero.persistence.UnidadeDAO" %>
<%@ page import="afero.persistence.EstoqueDAO" %>
<%@ page import="afero.persistence.LojaDAO" %>
<%@ page import="afero.persistence.PrecoDAO" %>
<%@page import="afero.persistence.OrcamentoItemDAO"%>
<%@ page import="java.util.List" %>
<%@ page import="java.util.Iterator" %>
<%@page import="afero.util.Utilitaria"%>

<link type="text/css" rel="Stylesheet" href="../css/afero.css" />
<script src="../js/common.js"/></script>

<script>
function localizar() {
  document.forms[0].action="formCadastroItensOrcamento.jsp?acao=listar";
  document.forms[0].submit();
}  
function novaPesquisa() {
  document.forms[0].action="formCadastroItensOrcamento.jsp?acao=listar";
  document.all.nomeProduto.value = '';
  document.all.status.value = ''; //não está limpando
  document.forms[0].submit();
} 
function salvar() {
  document.forms[0].action="formCadastroItensOrcamento.jsp?acao=gravar";
  document.forms[0].submit();
  
}
function cancelar() {
  document.forms[0].action="formCadastroItensOrcamento.jsp?acao=listar";
  document.forms[0].submit();
}
function apenasnum()
{
  var tecla = window.event.keyCode;
  tecla     = String.fromCharCode(tecla);
  if(!((tecla >= "0") && (tecla <= "9")))
  {
    window.event.keyCode = 0;
  }
}

function CheckContent(evt){
        var charCode = (evt.which) ? evt.which : event.keyCode;
        return (charCode>=48 && charCode<=57 || charCode<20);
      }
function atualizaQuantidadeValor(I) {
    var preco = document.getElementById('preco_'+I).value;
    var quant = document.getElementById('quantidadePedido_'+I).value
    var valor = quant;
    var total = valor.replace(",",".")*preco.replace(",",".");
    document.getElementById('vlUniPedido_'+I).value=total.toFixed(2);
    //function FormataValor(campo,tecla, dec, fl_neg) 
    
}
</script>
<%
String idLojaUsuario = (String)session.getAttribute("idLoja");
List list = null;
List listarEstoque = null;
ProdutoDAO dao;
EstoqueDAO daoEstoque;
Produto prod = null;
Estoque estoque =null;
String nomeProduto = request.getParameter("nomeProduto");
if(nomeProduto == null)nomeProduto = "";
String clausula = "";
int cont = 0;
String preco = "0";
String mensagem = request.getParameter("mensagem");
if(mensagem == null)mensagem = "";
int quantidadePedido = 0;
float pDescPedido = 0;
float vlUniPedido = 0;
if(acao.equalsIgnoreCase("gravar")){
	String[] idProduto = request.getParameterValues("produto");
	OrcamentoItem orcItem = new OrcamentoItem();
	OrcamentoItemDAO orcItemDAO = new OrcamentoItemDAO(conn);
	for(int I=0;I<idProduto.length;I++){
	  if(request.getParameter("idProduto_"+idProduto[I])!= null){
		  float quant = Utilitaria.toNumber(request.getParameter("quantidadePedido_"+idProduto[I])).floatValue();
		  if(quant >0){
		  	float precoInsert = Utilitaria.toNumber(request.getParameter("preco_"+idProduto[I])).floatValue();
		  	float pDescInsert = Utilitaria.toNumber(request.getParameter("pDescPedido_"+idProduto[I])).floatValue();
		  	//float vlUniInsert = Utilitaria.toNumber(request.getParameter("vlUniPedido_"+idProduto[I])).floatValue();
		  	orcItem.setAprovado("R");
		  	orcItem.setIdOrcamento(Integer.parseInt(idOrcamento));
		  	orcItem.setIdProduto(Integer.parseInt(request.getParameter("idProduto_"+idProduto[I])));
		  	orcItem.setIdUnidade(Integer.parseInt(request.getParameter("idUnidade_"+idProduto[I])));
		  	orcItem.setQuant(quant);
		  	orcItem.setValor(precoInsert);
		  	orcItem.setPDesc(pDescInsert);
		  	orcItem.setVlUni(orcItem.getValor()-orcItem.getVDesc());
		  	orcItem.setUsuario(usuario);
		  	orcItemDAO.incluir(orcItem);
		  }else{
			  response.sendRedirect("formCadastroItensOrcamento.jsp?acao=listar&mensagem=Quantidade tem que ser maior que 0 !!!&idOrcamento="+idOrcamento+"&idLoja="+idLoja+"&idEntrega="+idEntrega+"&idColaborador="+idColaborador+"&usuario="+usuario+"&status="+status+"&prazoValidade="+prazoValidade);		
		  }
		  
	  }
	}
}
%>
<body onload="document.forms[0].elements[0].focus();" >
<% if (mensagem != null) { %><div class="mensagem"><center><%= mensagem %></center></div><hr><% } %>
<form method="post" action="formCadastroItensOrcamento.jsp?acao=listar">
<input type="hidden" name="cont" value="<%=cont%>"/>
<input type="hidden" name="idOrcamento" value="<%=idOrcamento%>"/>
<input type="hidden" name="idLoja" value="<%=idLoja%>"/>
<input type="hidden" name="idEntrega" value="<%=idEntrega%>"/>
<input type="hidden" name="idColaborador" value="<%=idColaborador%>"/>
<input type="hidden" name="prazoValidade" value="<%=prazoValidade%>"/>
<input type="hidden" name="usuario" value="<%=usuario%>"/>
<input type="hidden" name="status" value="<%=status%>"/>

<table colspan="2">
  <tr>
    <th class='label'>Descrição do Produto</th>
    <td><input type="text" name="nomeProduto" <%if (nomeProduto != null) { %>value="<%=nomeProduto%>"<% }%>  size="40" maxlength="40"></td>
    <td><input class="button" type="button" value="Localizar" onClick="javascript: localizar();" /></td>
    <td><input class="button" type="button" value="Nova pesquisa" onClick="javascript: novaPesquisa();" /></td>
  </tr>
  <tr>
    <th class="label">Status</th>
    <td class="label_radio">
      <input type="radio" class="radio" name="statusConsulta" value="" <%= (statusConsulta.equals("")? "checked": "") %>>Todos
      <input type="radio" class="radio" name="statusConsulta" value="A" <%= (statusConsulta.equals("A")? "checked": "") %>>Ativo
      <input type="radio" class="radio" name="statusConsulta" value="I" <%= (statusConsulta.equals("I")? "checked": "") %>>Inativo</td>
  </tr>
</table>
<hr>
<%-- mostra todos os registros do banco de dados --%>
<table border="0" width="100%">
    <tr>
      
      <th class="grid"><center></center></th>
       <th class="grid">Selecionar</th>
      <th class="grid">Loja</th>
      <th class="grid"><center>Descrição do Produto</center></th>
      <th class="grid">Tipo do Produto</th>
      <th class="grid">Status</th>
      <th class="grid">Preço</th>
      <th class="grid">Estoque</th>
      <th class="grid">Quantidade</th>
      <th class="grid">% Desc.</th>
      <th class="grid">Vl.Unitário</th>
      <th class="grid">Unidade</th>
    </tr>
<%
//Utiliza o ResultSet para trazer os registros do banco de dados
  if (nomeProduto!= null) {
 	     clausula = " WHERE  p.status='"+statusConsulta+"' AND p.dsProduto LIKE '"+nomeProduto+"%'  OR p.cdBarra LIKE '"+nomeProduto+"%' ";
  } 
  
 dao = new ProdutoDAO(conn);
 clausula = clausula+" ORDER BY p.dsProduto ";
if(nomeProduto != ""){
  list = dao.listarProdutoPrecoLoja(clausula, Integer.parseInt(idLojaUsuario));
  for ( Iterator it = list.iterator(); it.hasNext();) {
	prod = (Produto) it.next();
	daoEstoque = new EstoqueDAO(conn);
	listarEstoque = daoEstoque.procurarEstoqueLoja(prod.getIdProduto(), Integer.parseInt(idLojaUsuario));
	if(listarEstoque != null){
	for (Iterator itListar = listarEstoque.iterator(); itListar.hasNext();){
		cont++;
		estoque = (Estoque) itListar.next();
		LojaDAO lojaPreco = new LojaDAO(conn);
		Loja lojaEstoque = lojaPreco.procurarLoja(estoque.getIdLoja());
		PrecoDAO daoPrecoListar = new PrecoDAO(conn);
		Preco precoListar = daoPrecoListar.procurarPrecoEstoqueLoja(estoque.getIdEstoque(), Integer.parseInt(idLojaUsuario));
		if(precoListar!=null){
			preco = Utilitaria.formatarNumero(precoListar.getPreco(), 2).toString();
			UnidadeDAO daoUnidade = new UnidadeDAO(conn);
			Unidade unidadeListar = daoUnidade.procurarUnidade(precoListar.getIdUnidade());
%>
    <tr>
      <td class = "grid" width="1%"><center><%=cont%></center></td>
      <td class = "grid" width="3%"><input type="checkbox" name="idProduto_<%=prod.getIdProduto()%>" value="<%=prod.getIdProduto()%>"></td>
      <td class = "grid" width="5%"><center><%=lojaEstoque.getApelido()%></center></td>
      <td class = "grid" width="10%"><center><%=prod.getDsProduto() %></center></td>
      <td class = "grid" width="2%"><center><%=prod.getTipoProduto()%></center></td>
      <td class = "grid" width="2%"><center><%=prod.getStatus()%></center></td>
      <td class = "grid" width="2%"><center><%=preco%></center></td>
      <%if (estoque.getQtEstoque()<=estoque.getQtMinimo()){ %>
      	 <td class = "grid" width="3%" title="ESTOQUE ESTÁ COM A QUANTIDADE MINIMA NO LIMITE OU ULTRAPASSOU."><center><font color="red"><b><i><%=Utilitaria.formatarNumero(estoque.getQtEstoque(),2)%></i></b></font></center></td>
      <%}else{ %>
      	 <td class = "grid" width="3%" ><center><%=Utilitaria.formatarNumero(estoque.getQtEstoque(),2)%></center></td>
      <%} %>
      <td class = "grid" width="3%"><input type="text" name="quantidadePedido_<%=prod.getIdProduto()%>" value="<%=quantidadePedido%>" maxlength="7" size="7" onblur="atualizaQuantidadeValor(<%=prod.getIdProduto()%>)"></td>
      <td class = "grid" width="3%"><input type="text" name="pDescPedido_<%=prod.getIdProduto()%>" value="<%=pDescPedido%>" maxlength="7" size="7"></td>
      <td class = "grid" width="3%"><input disabled type="text" name="vlUniPedido_<%=prod.getIdProduto()%>" value="<%=vlUniPedido%>"maxlength="7" size="7"></td>
      <td class = "grid" width="2%"><center><%=unidadeListar.getDsUnidade()%></center></td>
  </tr>
  <input type="hidden" name="produto" value="<%=prod.getIdProduto()%>"/>
   <input type="hidden" name="idUnidade_<%=prod.getIdProduto()%>" value="<%=unidadeListar.getIdUnidade()%>"/>
   <input type="hidden" name="preco_<%=prod.getIdProduto()%>" value="<%=preco%>" >

<%
		}
	}
	}
}
}//else{
	//response.sendRedirect("formCadastroItensOrcamento.jsp?acao=listar&idOrcamento="+idOrcamento+"&idLoja="+idLoja+"&idEntrega="+idEntrega+"&idColaborador="+idColaborador+"&prazoValidade="+prazoValidade+"&usuario="+usuario+"&status="+status);
//}
	
%>
  
</table>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
<tr>
    <br>
	<td><input class="button" type="button" value="Adicionar" onClick="javascript: salvar();" />
	<input class="button" type="button" value="Cancelar" onClick="javascript: cancelar();" /></td>
</tr>
</table>
</form>