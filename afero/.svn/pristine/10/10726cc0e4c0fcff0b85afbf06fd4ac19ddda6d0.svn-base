package afero.model;

import java.util.Date;

public class Cotacao {
	
	private int idCotacao;
	private int idLoja;
	private int idColaborador;
	private Date dtCotacao;
	private String observacao;
	private String status;
	private Date dtMod;
	private String usuario;
	
	public Cotacao(int idCotacao, int idLoja, int idColaborador,
			Date dtCotacao, String observacao, String status, Date dtMod,
			String usuario) {
		this.idCotacao = idCotacao;
		this.idLoja = idLoja;
		this.idColaborador = idColaborador;
		this.dtCotacao = dtCotacao;
		this.observacao = observacao;
		this.status = status;
		this.dtMod = dtMod;
		this.usuario = usuario;
	}
	
	public Cotacao(){}
	
	public int getIdCotacao() {
		return idCotacao;
	}
	
	public void setIdCotacao(int idCotacao) {
		this.idCotacao = idCotacao;
	}
	
	public int getIdLoja() {
		return idLoja;
	}
	
	public void setIdLoja(int idLoja) {
		this.idLoja = idLoja;
	}
	
	public int getIdColaborador() {
		return idColaborador;
	}
	
	public void setIdColaborador(int idColaborador) {
		this.idColaborador = idColaborador;
	}
	
	public Date getDtCotacao() {
		return dtCotacao;
	}
	
	public void setDtCotacao(Date dtCotacao) {
		this.dtCotacao = dtCotacao;
	}
	
	public String getObservacao() {
		return observacao;
	}
	
	public void setObservacao(String observacao) {
		this.observacao = observacao;
	}
	
	public String getStatus() {
		return status;
	}
	
	public void setStatus(String status) {
		this.status = status;
	}
	
	public Date getDtMod() {
		return dtMod;
	}
	
	public void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}
	
	public String getUsuario() {
		return usuario;
	}
	
	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}
	
}
