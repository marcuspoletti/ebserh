package afero.model;

import java.util.Date;

public class EntidadeEndereco {

	private int idEntidadeEndereco;
	private int cdEntidade;
	private int cdTipoEndereco;
	private int cdTipoLogradouro;
	private int idCidade;
	private String dsEndereco;
	private String nroEndereco;
	private String cmpEndereco;
	private String baiEndereco;
	private String cepEndereco;
	private String cxpPostal;
	private String refEndereco;
	private String padrao;
	private Date dtMod;
	private String usuario;
	
	//Atualização Pizzaria
	
	private int idEntrega;

	public EntidadeEndereco() {

	}

	public EntidadeEndereco(int idEntidadeEndereco, int cdEntidade, int cdTipoEndereco,
			int cdTipoLogradouro, int idCidade, String dsEndereco,
			String nroEndereco, String cmpEndereco, String baiEndereco,
			String cepEndereco, String cxPostal, String referencia, 
			String padrao, Date dtMod, String usuario) {
		this.idEntidadeEndereco = idEntidadeEndereco;
		this.cdEntidade = cdEntidade;
		this.cdTipoEndereco = cdTipoEndereco;
		this.cdTipoLogradouro = cdTipoLogradouro;
		this.idCidade = idCidade;
		this.dsEndereco = dsEndereco;
		this.nroEndereco = nroEndereco;
		this.cmpEndereco = cmpEndereco;
		this.baiEndereco = baiEndereco;
		this.cepEndereco = cepEndereco;
		this.cxpPostal = cxPostal;
		this.refEndereco = referencia;
		this.padrao = padrao;
		this.dtMod = dtMod;
		this.usuario = usuario;
	}
	public EntidadeEndereco(int idEntidadeEndereco, int cdEntidade, int cdTipoEndereco,
			int cdTipoLogradouro, int idCidade, String dsEndereco,
			String nroEndereco, String cmpEndereco, String baiEndereco,
			String cepEndereco, String cxPostal, String referencia, 
			String padrao, Date dtMod, String usuario, int idEntrega) {
		this.idEntidadeEndereco = idEntidadeEndereco;
		this.cdEntidade = cdEntidade;
		this.cdTipoEndereco = cdTipoEndereco;
		this.cdTipoLogradouro = cdTipoLogradouro;
		this.idCidade = idCidade;
		this.dsEndereco = dsEndereco;
		this.nroEndereco = nroEndereco;
		this.cmpEndereco = cmpEndereco;
		this.baiEndereco = baiEndereco;
		this.cepEndereco = cepEndereco;
		this.cxpPostal = cxPostal;
		this.refEndereco = referencia;
		this.padrao = padrao;
		this.dtMod = dtMod;
		this.usuario = usuario;
		this.idEntrega = idEntrega;
	}
	public final int getIdEntidadeEndereco() {
		return idEntidadeEndereco;
	}

	public final void setIdEntidadeEndereco(int idEndereco) {
		this.idEntidadeEndereco = idEndereco;
	}

	public final int getCdEntidade() {
		return cdEntidade;
	}

	public final void setCdEntidade(int cdEntidade) {
		this.cdEntidade = cdEntidade;
	}

	public final int getCdTipoEndereco() {
		return cdTipoEndereco;
	}

	public final void setCdTipoEndereco(int cdTipoEndereco) {
		this.cdTipoEndereco = cdTipoEndereco;
	}

	public final int getCdTipoLogradouro() {
		return cdTipoLogradouro;
	}

	public final void setCdTipoLogradouro(int cdTipoLogradouro) {
		this.cdTipoLogradouro = cdTipoLogradouro;
	}

	public final int getIdCidade() {
		return idCidade;
	}

	public final void setIdCidade(int idCidade) {
		this.idCidade = idCidade;
	}

	public final String getDsEndereco() {
		return dsEndereco;
	}

	public final void setDsEndereco(String dsEndereco) {
		this.dsEndereco = dsEndereco;
	}

	public final String getNroEndereco() {
		return nroEndereco;
	}

	public final void setNroEndereco(String nroEndereco) {
		this.nroEndereco = nroEndereco;
	}

	public final String getCmpEndereco() {
		return cmpEndereco;
	}

	public final void setCmpEndereco(String cmpEndereco) {
		this.cmpEndereco = cmpEndereco;
	}

	public final String getBaiEndereco() {
		return baiEndereco;
	}

	public final void setBaiEndereco(String baiEndereco) {
		this.baiEndereco = baiEndereco;
	}

	public final String getCepEndereco() {
		return cepEndereco;
	}

	public final void setCepEndereco(String cepEndereco) {
		this.cepEndereco = cepEndereco;
	}

	public final String getCxpEndereco() {
		return cxpPostal;
	}

	public final void setCxpEndereco(String cxpPostal) {
		this.cxpPostal = cxpPostal;
	}

	public final String getRefEndereco() {
		return refEndereco;
	}

	public final void setRefEndereco(String refEndereco) {
		this.refEndereco = refEndereco;
	}

	public final String getPadrao() {
		return padrao;
	}

	public final void setPadrao(String padrao) {
		this.padrao = padrao;
	}

	public final Date getDtMod() {
		return dtMod;
	}

	public final void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}

	public final String getUsuario() {
		return usuario;
	}

	public final void setUsuario(String usuario) {
		this.usuario = usuario;
	}

	public String getCxpPostal() {
		return cxpPostal;
	}

	public void setCxpPostal(String cxpPostal) {
		this.cxpPostal = cxpPostal;
	}

	public int getIdEntrega() {
		return idEntrega;
	}

	public void setIdEntrega(int idEntrega) {
		this.idEntrega = idEntrega;
	}
	
}
