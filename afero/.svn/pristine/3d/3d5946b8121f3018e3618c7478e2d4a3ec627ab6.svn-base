package afero.model;

import java.util.Date;

public class OrcamentoSubItens {
	
	private int idOrcamentoSubItem;
	private int idOrcamentoItem;
	private int idProduto;
	private int idUnidade;
	private float comp;
	private float larg;
	private float quant;
	private float pDesc;
	private float vlUni;
	private Date dtMod;
	private String usuario;

	public OrcamentoSubItens() {
		
	}
	
	public OrcamentoSubItens(int idOrcamentoSubItem, int idOrcamentoItem,
			int idProduto, int idUnidade, float comp, float larg, float quant,
			float pDesc, float vlUni, Date dtMod, String usuario) {
		
		this.idOrcamentoSubItem = idOrcamentoSubItem;
		this.idOrcamentoItem = idOrcamentoItem;
		this.idProduto = idProduto;
		this.idUnidade = idUnidade;
		this.comp = comp;
		this.larg = larg;
		this.quant = quant;
		this.pDesc = pDesc;
		this.vlUni = vlUni;
		this.dtMod = dtMod;
		this.usuario = usuario;
	}
	
	
	public int getIdOrcamentoSubItem() {
		return idOrcamentoSubItem;
	}

	public void setIdOrcamentoSubItem(int idOrcamentoSubItem) {
		this.idOrcamentoSubItem = idOrcamentoSubItem;
	}

	public int getIdOrcamentoItem() {
		return idOrcamentoItem;
	}

	public void setIdOrcamentoItem(int idOrcamentoItem) {
		this.idOrcamentoItem = idOrcamentoItem;
	}

	public int getIdProduto() {
		return idProduto;
	}

	public void setIdProduto(int idProduto) {
		this.idProduto = idProduto;
	}

	public int getIdUnidade() {
		return idUnidade;
	}

	public void setIdUnidade(int idUnidade) {
		this.idUnidade = idUnidade;
	}

	public float getComp() {
		return comp;
	}

	public void setComp(float comp) {
		this.comp = comp;
	}

	public float getLarg() {
		return larg;
	}

	public void setLarg(float larg) {
		this.larg = larg;
	}

	public float getQuant() {
		return quant;
	}

	public void setQuant(float quant) {
		this.quant = quant;
	}

	public float getpDesc() {
		return pDesc;
	}

	public void setpDesc(float pDesc) {
		this.pDesc = pDesc;
	}

	public float getVlUni() {
		return vlUni;
	}

	public void setVlUni(float vlUni) {
		this.vlUni = vlUni;
	}

	public Date getDtMod() {
		return dtMod;
	}

	public void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}

	public String getUsuario() {
		return usuario;
	}

	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}
	
	
}
