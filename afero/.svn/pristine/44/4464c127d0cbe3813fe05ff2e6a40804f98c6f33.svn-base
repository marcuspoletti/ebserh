package afero.model;


import java.util.*;

public class Tranferencia {
	
	private int idTransferencia = 0;
	private int idContaDe = 0;
	private int idContaPara = 0;
	private String historico = "";
	private String LancaAutomatico = "";
	private Date dtVenc = null;
	private int cdTipoFrequencia = 0;
	private String informaParcelas = "";
	private int quantParcelas = 0;
	private Date dtUltimoVenc = null;
	private double valor = 0;
	private int cdFormaPagto = 0;
	private int idColaborador = 0;
	private String status = "";
	private Date dtMov = null;
	private String usuario = "";
	
	public Tranferencia(int idTransferencia, int idContaDe, int idContaPara,
			String historico, String lancaAutomatico, Date dtVenc,
			int cdTipoFrequencia, String informaParcelas, int quantParcelas,
			Date dtUltimoVenc, double valor, int cdFormaPagto,
			int idColaborador, String status, Date dtMov, String usuario) {
		this.idTransferencia = idTransferencia;
		this.idContaDe = idContaDe;
		this.idContaPara = idContaPara;
		this.historico = historico;
		LancaAutomatico = lancaAutomatico;
		this.dtVenc = dtVenc;
		this.cdTipoFrequencia = cdTipoFrequencia;
		this.informaParcelas = informaParcelas;
		this.quantParcelas = quantParcelas;
		this.dtUltimoVenc = dtUltimoVenc;
		this.valor = valor;
		this.cdFormaPagto = cdFormaPagto;
		this.idColaborador = idColaborador;
		this.status = status;
		this.dtMov = dtMov;
		this.usuario = usuario;
	}
	public Tranferencia() {
		
	}
	
	public int getIdTransferencia() {
		return idTransferencia;
	}
	public void setIdTransferencia(int idTransferencia) {
		this.idTransferencia = idTransferencia;
	}
	public int getIdContaDe() {
		return idContaDe;
	}
	public void setIdContaDe(int idContaDe) {
		this.idContaDe = idContaDe;
	}
	public int getIdContaPara() {
		return idContaPara;
	}
	public void setIdContaPara(int idContaPara) {
		this.idContaPara = idContaPara;
	}
	public String getHistorico() {
		return historico;
	}
	public void setHistorico(String historico) {
		this.historico = historico;
	}
	public String getLancaAutomatico() {
		return LancaAutomatico;
	}
	public void setLancaAutomatico(String lancaAutomatico) {
		LancaAutomatico = lancaAutomatico;
	}
	public Date getDtVenc() {
		return dtVenc;
	}
	public void setDtVenc(Date dtVenc) {
		this.dtVenc = dtVenc;
	}
	public int getCdTipoFrequencia() {
		return cdTipoFrequencia;
	}
	public void setCdTipoFrequencia(int cdTipoFrequencia) {
		this.cdTipoFrequencia = cdTipoFrequencia;
	}
	public String getInformaParcelas() {
		return informaParcelas;
	}
	public void setInformaParcelas(String informaParcelas) {
		this.informaParcelas = informaParcelas;
	}
	public int getQuantParcelas() {
		return quantParcelas;
	}
	public void setQuantParcelas(int quantParcelas) {
		this.quantParcelas = quantParcelas;
	}
	public Date getDtUltimoVenc() {
		return dtUltimoVenc;
	}
	public void setDtUltimoVenc(Date dtUltimoVenc) {
		this.dtUltimoVenc = dtUltimoVenc;
	}
	public double getValor() {
		return valor;
	}
	public void setValor(double valor) {
		this.valor = valor;
	}
	public int getCdFormaPagto() {
		return cdFormaPagto;
	}
	public void setCdFormaPagto(int cdFormaPagto) {
		this.cdFormaPagto = cdFormaPagto;
	}
	public int getIdColaborador() {
		return idColaborador;
	}
	public void setIdColaborador(int idColaborador) {
		this.idColaborador = idColaborador;
	}
	public String getStatus() {
		return status;
	}
	public void setStatus(String status) {
		this.status = status;
	}
	public Date getDtMov() {
		return dtMov;
	}
	public void setDtMov(Date dtMov) {
		this.dtMov = dtMov;
	}
	public String getUsuario() {
		return usuario;
	}
	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}
	
	
	

}
