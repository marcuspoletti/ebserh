package afero.model;

public class RamoAtividade {
	
	private int idRamoAtividade;
	private String dsRamoAtividade;
	private String status;
	
	public RamoAtividade() {
		
	}
	
	public RamoAtividade(int idRamoAtividade, String dsRamoAtividade, String status) {
		this.idRamoAtividade = idRamoAtividade;
		this.dsRamoAtividade = dsRamoAtividade;
		this.status = status;
	}

	public final int getIdRamoAtividade() {
		return idRamoAtividade;
	}

	public final void setIdRamoAtividade(int idRamoAtividade) {
		this.idRamoAtividade = idRamoAtividade;
	}

	public final String getDsRamoAtividade() {
		return dsRamoAtividade;
	}

	public final void setDsRamoAtividade(String dsRamoAtividade) {
		this.dsRamoAtividade = dsRamoAtividade;
	}

	public final String getStatus() {
		return status;
	}

	public final void setStatus(String status) {
		this.status = status;
	}

}
