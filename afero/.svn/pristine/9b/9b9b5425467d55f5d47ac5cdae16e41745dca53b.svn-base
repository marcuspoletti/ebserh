package afero.model;

import java.util.Date;

public class PedidoEntradaItem {
	
	private int idPedidoEntradaItem;
	private int idPedidoEntrada;
	private int idProduto;
	private int idUnidade;
	private float quantPedida;
	private float quant;
	private float valor;
	private String loteFab;
	private Date dtVal;
	private Date dtMod;
	private String usuario;
	
	//Fiscal
	private String nfINcm;
	private String nfICFOP;
	private String nfNCST;
	private String nfNCSOSN;
	private float nfNvBC;
	private float nfNvBCST;
	private String nfNpICMSST;
	private float nfNvICMSST;
	private float nfNpICMS;
	private float nfNvICMS;
	private String nfOCST;
	private String nfOvBC;
	private float nfOpIPI;
	private float nfOvIPI;
	
	
	
	
	public PedidoEntradaItem(int idPedidoEntradaItem, int idPedidoEntrada,
			int idProduto, int idUnidade, float quantPedida, float quant,
			float valor, String loteFab, Date dtVal, Date dtMod,
			String usuario, String nfINcm, String nfICFOP, String nfNCST,
			String nfNCSOSN, float nfNvBC, float nfNvBCST, String nfNpICMSST,
			float nfNvICMSST, float nfNpICMS, float nfNvICMS, String nfOCST,
			String nfOvBC, float nfOpIPI, float nfOvIPI) {
		
		this.idPedidoEntradaItem = idPedidoEntradaItem;
		this.idPedidoEntrada = idPedidoEntrada;
		this.idProduto = idProduto;
		this.idUnidade = idUnidade;
		this.quantPedida = quantPedida;
		this.quant = quant;
		this.valor = valor;
		this.loteFab = loteFab;
		this.dtVal = dtVal;
		this.dtMod = dtMod;
		this.usuario = usuario;
		this.nfINcm = nfINcm;
		this.nfICFOP = nfICFOP;
		this.nfNCST = nfNCST;
		this.nfNCSOSN = nfNCSOSN;
		this.nfNvBC = nfNvBC;
		this.nfNvBCST = nfNvBCST;
		this.nfNpICMSST = nfNpICMSST;
		this.nfNvICMSST = nfNvICMSST;
		this.nfNpICMS = nfNpICMS;
		this.nfNvICMS = nfNvICMS;
		this.nfOCST = nfOCST;
		this.nfOvBC = nfOvBC;
		this.nfOpIPI = nfOpIPI;
		this.nfOvIPI = nfOvIPI;
	}

	public PedidoEntradaItem(){}
	
	public PedidoEntradaItem(int idPedidoEntradaItem, int idPedidoEntrada,
			int idProduto, int idUnidade, float quantPedida, float quant,
			float valor, String loteFab, Date dtVal, Date dtMod, String usuario) {
		this.idPedidoEntradaItem = idPedidoEntradaItem;
		this.idPedidoEntrada = idPedidoEntrada;
		this.idProduto = idProduto;
		this.idUnidade = idUnidade;
		this.quantPedida = quantPedida;
		this.quant = quant;
		this.valor = valor;
		this.loteFab = loteFab;
		this.dtVal = dtVal;
		this.dtMod = dtMod;
		this.usuario = usuario;
	}
	
	
	public String getNfINcm() {
		return nfINcm;
	}

	public void setNfINcm(String nfINcm) {
		this.nfINcm = nfINcm;
	}

	public String getNfICFOP() {
		return nfICFOP;
	}

	public void setNfICFOP(String nfICFOP) {
		this.nfICFOP = nfICFOP;
	}

	public String getNfNCST() {
		return nfNCST;
	}

	public void setNfNCST(String nfNCST) {
		this.nfNCST = nfNCST;
	}

	public String getNfNCSOSN() {
		return nfNCSOSN;
	}

	public void setNfNCSOSN(String nfNCSOSN) {
		this.nfNCSOSN = nfNCSOSN;
	}

	public float getNfNvBC() {
		return nfNvBC;
	}

	public void setNfNvBC(float nfNvBC) {
		this.nfNvBC = nfNvBC;
	}

	public float getNfNvBCST() {
		return nfNvBCST;
	}

	public void setNfNvBCST(float nfNvBCST) {
		this.nfNvBCST = nfNvBCST;
	}

	public String getNfNpICMSST() {
		return nfNpICMSST;
	}

	public void setNfNpICMSST(String nfNpICMSST) {
		this.nfNpICMSST = nfNpICMSST;
	}

	public float getNfNvICMSST() {
		return nfNvICMSST;
	}

	public void setNfNvICMSST(float nfNvICMSST) {
		this.nfNvICMSST = nfNvICMSST;
	}

	public float getNfNpICMS() {
		return nfNpICMS;
	}

	public void setNfNpICMS(float nfNpICMS) {
		this.nfNpICMS = nfNpICMS;
	}

	public float getNfNvICMS() {
		return nfNvICMS;
	}

	public void setNfNvICMS(float nfNvICMS) {
		this.nfNvICMS = nfNvICMS;
	}

	public String getNfOCST() {
		return nfOCST;
	}

	public void setNfOCST(String nfOCST) {
		this.nfOCST = nfOCST;
	}

	public String getNfOvBC() {
		return nfOvBC;
	}

	public void setNfOvBC(String nfOvBC) {
		this.nfOvBC = nfOvBC;
	}

	public float getNfOpIPI() {
		return nfOpIPI;
	}

	public void setNfOpIPI(float nfOpIPI) {
		this.nfOpIPI = nfOpIPI;
	}

	public float getNfOvIPI() {
		return nfOvIPI;
	}

	public void setNfOvIPI(float nfOvIPI) {
		this.nfOvIPI = nfOvIPI;
	}

	public int getIdPedidoEntradaItem() {
		return idPedidoEntradaItem;
	}
	public void setIdPedidoEntradaItem(int idPedidoEntradaItem) {
		this.idPedidoEntradaItem = idPedidoEntradaItem;
	}
	public int getIdPedidoEntrada() {
		return idPedidoEntrada;
	}
	public void setIdPedidoEntrada(int idPedidoEntrada) {
		this.idPedidoEntrada = idPedidoEntrada;
	}
	public int getIdProduto() {
		return idProduto;
	}
	public void setIdProduto(int idProduto) {
		this.idProduto = idProduto;
	}
	public int getIdUnidade() {
		return idUnidade;
	}
	public void setIdUnidade(int idUnidade) {
		this.idUnidade = idUnidade;
	}
	public float getQuantPedida() {
		return quantPedida;
	}
	public void setQuantPedida(float quantPedida) {
		this.quantPedida = quantPedida;
	}
	public float getQuant() {
		return quant;
	}
	public void setQuant(float quant) {
		this.quant = quant;
	}
	public float getValor() {
		return valor;
	}
	public void setValor(float valor) {
		this.valor = valor;
	}
	public String getLoteFab() {
		return loteFab;
	}
	public void setLoteFab(String loteFab) {
		this.loteFab = loteFab;
	}
	public Date getDtVal() {
		return dtVal;
	}
	public void setDtVal(Date dtVal) {
		this.dtVal = dtVal;
	}
	public Date getDtMod() {
		return dtMod;
	}
	public void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}
	public String getUsuario() {
		return usuario;
	}
	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}
	

