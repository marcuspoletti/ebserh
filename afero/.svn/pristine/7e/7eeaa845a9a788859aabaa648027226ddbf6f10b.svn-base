package afero.integracao.xprocess;

public class Modalidade {
	
	private Integer tipo;
	private String idModalidade;
	private String dscModalidade;
	private String quantParcelas;
	private String naoUsado;
	private String tipoPagamentoNFC;
	private String naoUsado1;
	
	
	public Modalidade() {
		
	}


	public Modalidade(Integer tipo, String idModalidade, String dscModalidade,
			String quantParcelas, String naoUsado, String tipoPagamentoNFC,
			String naoUsado1) {
		
		this.tipo = tipo;
		this.idModalidade = idModalidade;
		this.dscModalidade = dscModalidade;
		this.quantParcelas = quantParcelas;
		this.naoUsado = naoUsado;
		this.tipoPagamentoNFC = tipoPagamentoNFC;
		this.naoUsado1 = naoUsado1;
	}


	public Modalidade(Integer tipo, String idModalidade, String dscModalidade,
			String quantParcelas, String naoUsado, String tipoPagamentoNFC) {
		
		this.tipo = tipo;
		this.idModalidade = idModalidade;
		this.dscModalidade = dscModalidade;
		this.quantParcelas = quantParcelas;
		this.naoUsado = naoUsado;
		this.tipoPagamentoNFC = tipoPagamentoNFC;
	}


	public Integer getTipo() {
		return tipo;
	}


	public void setTipo(Integer tipo) {
		this.tipo = tipo;
	}


	public String getIdModalidade() {
		return idModalidade;
	}


	public void setIdModalidade(String idModalidade) {
		this.idModalidade = idModalidade;
	}


	public String getDscModalidade() {
		return dscModalidade;
	}


	public void setDscModalidade(String dscModalidade) {
		this.dscModalidade = dscModalidade;
	}


	public String getQuantParcelas() {
		return quantParcelas;
	}


	public void setQuantParcelas(String quantParcelas) {
		this.quantParcelas = quantParcelas;
	}


	public String getNaoUsado() {
		return naoUsado;
	}


	public void setNaoUsado(String naoUsado) {
		this.naoUsado = naoUsado;
	}


	public String getTipoPagamentoNFC() {
		return tipoPagamentoNFC;
	}


	public void setTipoPagamentoNFC(String tipoPagamentoNFC) {
		this.tipoPagamentoNFC = tipoPagamentoNFC;
	}


	public String getNaoUsado1() {
		return naoUsado1;
	}


	public void setNaoUsado1(String naoUsado1) {
		this.naoUsado1 = naoUsado1;
	}


}
