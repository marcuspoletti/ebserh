package aferopet.model;
import java.util.Date;

public class AnimalRetorno {
	
	private int idAnimalRetorno;
	private int idAnimal;
	private Date dtRetorno;
	private String descricao;
	private String lembrete;
	private int avisoTempo;
	private String avisoUnidade;
	private String status;
	private Date dtMod;
	private String usuario;
	
	public AnimalRetorno(){
	}

	public AnimalRetorno(int idAnimalRetorno, int idAnimal, Date dtRetorno,
			String descricao, String lembrete, int avisoTempo,
			String avisoUnidade, String status, Date dtMod, String usuario) {
		super();
		this.idAnimalRetorno = idAnimalRetorno;
		this.idAnimal = idAnimal;
		this.dtRetorno = dtRetorno;
		this.descricao = descricao;
		this.lembrete = lembrete;
		this.avisoTempo = avisoTempo;
		this.avisoUnidade = avisoUnidade;
		this.status = status;
		this.dtMod = dtMod;
		this.usuario = usuario;
	}

	public int getIdAnimalRetorno() {
		return idAnimalRetorno;
	}

	public void setIdAnimalRetorno(int idAnimalRetorno) {
		this.idAnimalRetorno = idAnimalRetorno;
	}

	public int getIdAnimal() {
		return idAnimal;
	}

	public void setIdAnimal(int idAnimal) {
		this.idAnimal = idAnimal;
	}

	public Date getDtRetorno() {
		return dtRetorno;
	}

	public void setDtRetorno(Date dtRetorno) {
		this.dtRetorno = dtRetorno;
	}

	public String getDescricao() {
		return descricao;
	}

	public void setDescricao(String descricao) {
		this.descricao = descricao;
	}

	public String getLembrete() {
		return lembrete;
	}

	public void setLembrete(String lembrete) {
		this.lembrete = lembrete;
	}

	public int getAvisoTempo() {
		return avisoTempo;
	}

	public void setAvisoTempo(int avisoTempo) {
		this.avisoTempo = avisoTempo;
	}

	public String getAvisoUnidade() {
		return avisoUnidade;
	}

	public void setAvisoUnidade(String avisoUnidade) {
		this.avisoUnidade = avisoUnidade;
	}

	public String getStatus() {
		return status;
	}

	public void setStatus(String status) {
		this.status = status;
	}

	public Date getDtMod() {
		return dtMod;
	}

	public void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}

	public String getUsuario() {
		return usuario;
	}

	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}

}
