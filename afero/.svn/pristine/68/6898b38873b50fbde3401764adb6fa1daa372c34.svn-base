package afero.persistence;

import java.util.List;
import afero.model.EntidadeEmail;

public interface IEntidadeEmailDAO {
	
	void incluir(EntidadeEmail entidadeEmail) throws AferoDAOException;

	public void atualizar(EntidadeEmail entidadeEmail) throws AferoDAOException;

	public void excluir(EntidadeEmail entidadeEmail) throws AferoDAOException;

	public EntidadeEmail procurarEntidadeEmail(int idEntidadeEmail) throws AferoDAOException;

	public List<EntidadeEmail> listarEntidadeEmail(String clausula) throws AferoDAOException;

}
