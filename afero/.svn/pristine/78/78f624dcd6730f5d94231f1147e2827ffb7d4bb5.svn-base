package afero.model;

public class CondPagto {
	
	private int cdCondPagto;
	private String dsCondPagto;
	private String status;

	public CondPagto() {
	}
	
	public CondPagto(int cdCondPagto, String dsCondPagto, String status) {
		
		this.cdCondPagto = cdCondPagto;
		this.dsCondPagto = dsCondPagto;
		this.status = status;
	}

	public int getCdCondPagto() {
		return cdCondPagto;
	}

	public void setCdCondPagto(int cdCondPagto) {
		this.cdCondPagto = cdCondPagto;
	}

	public String getDsCondPagto() {
		return dsCondPagto;
	}

	public void setDsCondPagto(String dsCondPagto) {
		this.dsCondPagto = dsCondPagto;
	}

	public String getStatus() {
		return status;
	}

	public void setStatus(String status) {
		this.status = status;
	}
	
	

}
