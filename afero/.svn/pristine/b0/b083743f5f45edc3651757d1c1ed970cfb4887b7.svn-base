package aferopet.model;
import java.util.Date;

public class AnimalFicha {
	
	private int idAnimalFicha;
	private int idAnimal;
	private Date dtAtend;
	private String descricao;
	private int peso;
	private int altura;
	private String observacao;
	private String exame;
	private String tipoAtividade;
	private Date dtMod;
	private String usuario;
	
	public AnimalFicha(){
	}

	public AnimalFicha(int idAnimalFicha, int idAnimal, Date dtAtend,
			String descricao, int peso, int altura, String observacao,
			String exame, String tipoAtividade, Date dtMod, String usuario) {
		super();
		this.idAnimalFicha = idAnimalFicha;
		this.idAnimal = idAnimal;
		this.dtAtend = dtAtend;
		this.descricao = descricao;
		this.peso = peso;
		this.altura = altura;
		this.observacao = observacao;
		this.exame = exame;
		this.tipoAtividade = tipoAtividade;
		this.dtMod = dtMod;
		this.usuario = usuario;
	}

	public int getIdAnimalFicha() {
		return idAnimalFicha;
	}

	public void setIdAnimalFicha(int idAnimalFicha) {
		this.idAnimalFicha = idAnimalFicha;
	}

	public int getIdAnimal() {
		return idAnimal;
	}

	public void setIdAnimal(int idAnimal) {
		this.idAnimal = idAnimal;
	}

	public Date getDtAtend() {
		return dtAtend;
	}

	public void setDtAtend(Date dtAtend) {
		this.dtAtend = dtAtend;
	}

	public String getDescricao() {
		return descricao;
	}

	public void setDescricao(String descricao) {
		this.descricao = descricao;
	}

	public int getPeso() {
		return peso;
	}

	public void setPeso(int peso) {
		this.peso = peso;
	}

	public int getAltura() {
		return altura;
	}

	public void setAltura(int altura) {
		this.altura = altura;
	}

	public String getObservacao() {
		return observacao;
	}

	public void setObservacao(String observacao) {
		this.observacao = observacao;
	}

	public String getExame() {
		return exame;
	}

	public void setExame(String exame) {
		this.exame = exame;
	}

	public String getTipoAtividade() {
		return tipoAtividade;
	}

	public void setTipoAtividade(String tipoAtividade) {
		this.tipoAtividade = tipoAtividade;
	}

	public Date getDtMod() {
		return dtMod;
	}

	public void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}

	public String getUsuario() {
		return usuario;
	}

	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}

}
