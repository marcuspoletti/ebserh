package afero.integracao.xprocess;

public class NfeLancamento {
	
	private Integer idNfe;
	private String dt_registro;
	private String id_modalidade_pagamento;
	private String ds_modalidade_pagamento;
	private String valor;
	private String dt_vencimento;
	private String caut;
	private String nr_banco;
	private String nr_cheque;
	private String nr_conta;
	private String nr_agencia;
	
	
	public NfeLancamento(Integer idNfe, String dt_registro,
			String id_modalidade_pagamento, String ds_modalidade_pagamento,
			String valor, String dt_vencimento, String caut, String nr_banco,
			String nr_cheque, String nr_conta, String nr_agencia) {
		super();
		this.idNfe = idNfe;
		this.dt_registro = dt_registro;
		this.id_modalidade_pagamento = id_modalidade_pagamento;
		this.ds_modalidade_pagamento = ds_modalidade_pagamento;
		this.valor = valor;
		this.dt_vencimento = dt_vencimento;
		this.caut = caut;
		this.nr_banco = nr_banco;
		this.nr_cheque = nr_cheque;
		this.nr_conta = nr_conta;
		this.nr_agencia = nr_agencia;
	}


	public NfeLancamento() {
		super();
		// TODO Auto-generated constructor stub
	}


	public Integer getIdNfe() {
		return idNfe;
	}


	public void setIdNfe(Integer idNfe) {
		this.idNfe = idNfe;
	}


	public String getDt_registro() {
		return dt_registro;
	}


	public void setDt_registro(String dt_registro) {
		this.dt_registro = dt_registro;
	}


	public String getId_modalidade_pagamento() {
		return id_modalidade_pagamento;
	}


	public void setId_modalidade_pagamento(String id_modalidade_pagamento) {
		this.id_modalidade_pagamento = id_modalidade_pagamento;
	}


	public String getDs_modalidade_pagamento() {
		return ds_modalidade_pagamento;
	}


	public void setDs_modalidade_pagamento(String ds_modalidade_pagamento) {
		this.ds_modalidade_pagamento = ds_modalidade_pagamento;
	}


	public String getValor() {
		return valor;
	}


	public void setValor(String valor) {
		this.valor = valor;
	}


	public String getDt_vencimento() {
		return dt_vencimento;
	}


	public void setDt_vencimento(String dt_vencimento) {
		this.dt_vencimento = dt_vencimento;
	}


	public String getCaut() {
		return caut;
	}


	public void setCaut(String caut) {
		this.caut = caut;
	}


	public String getNr_banco() {
		return nr_banco;
	}


	public void setNr_banco(String nr_banco) {
		this.nr_banco = nr_banco;
	}


	public String getNr_cheque() {
		return nr_cheque;
	}


	public void setNr_cheque(String nr_cheque) {
		this.nr_cheque = nr_cheque;
	}


	public String getNr_conta() {
		return nr_conta;
	}


	public void setNr_conta(String nr_conta) {
		this.nr_conta = nr_conta;
	}


	public String getNr_agencia() {
		return nr_agencia;
	}


	public void setNr_agencia(String nr_agencia) {
		this.nr_agencia = nr_agencia;
	}
	

}
