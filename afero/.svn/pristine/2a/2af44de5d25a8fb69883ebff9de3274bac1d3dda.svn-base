package afero.model;

public class UnidadeRelacaoUnidade {
	
	private int idunidadeDe = 0;
	private int idUnidadePara = 0;
	private String dsUnidadeDe = "";
	private String dsUnidadePara = "";
	
	public UnidadeRelacaoUnidade(){}
	
	public UnidadeRelacaoUnidade(int idunidadeDe, int idUnidadePara,
			String dsUnidadeDe, String dsUnidadePara) {
		
		this.idunidadeDe = idunidadeDe;
		this.idUnidadePara = idUnidadePara;
		this.dsUnidadeDe = dsUnidadeDe;
		this.dsUnidadePara = dsUnidadePara;
	}
	public int getIdunidadeDe() {
		return idunidadeDe;
	}
	public void setIdunidadeDe(int idunidadeDe) {
		this.idunidadeDe = idunidadeDe;
	}
	public int getIdUnidadePara() {
		return idUnidadePara;
	}
	public void setIdUnidadePara(int idUnidadePara) {
		this.idUnidadePara = idUnidadePara;
	}
	public String getDsUnidadeDe() {
		return dsUnidadeDe;
	}
	public void setDsUnidadeDe(String dsUnidadeDe) {
		this.dsUnidadeDe = dsUnidadeDe;
	}
	public String getDsUnidadePara() {
		return dsUnidadePara;
	}
	public void setDsUnidadePara(String dsUnidadePara) {
		this.dsUnidadePara = dsUnidadePara;
	}
	
	

}
