package afero.model;

import java.util.*;

public class Unidade {
	
	private int idUnidade;
	private String dsUnidade;
	private Date dtCad;
	private Date dtMod;
	private String status;
	private String usuario;
	
	public Unidade(int idUnidade, String dsUnidade, Date dtCad, Date dtMod,
			String status, String usuario) {
		
		this.idUnidade = idUnidade;
		this.dsUnidade = dsUnidade;
		this.dtCad = dtCad;
		this.dtMod = dtMod;
		this.status = status;
		this.usuario = usuario;
	}

	public Unidade(){}

	public int getIdUnidade() {
		return idUnidade;
	}

	public void setIdUnidade(int idUnidade) {
		this.idUnidade = idUnidade;
	}

	public String getDsUnidade() {
		return dsUnidade;
	}

	public void setDsUnidade(String dsUnidade) {
		this.dsUnidade = dsUnidade;
	}

	public Date getDtCad() {
		return dtCad;
	}

	public void setDtCad(Date dtCad) {
		this.dtCad = dtCad;
	}

	public Date getDtMod() {
		return dtMod;
	}

	public void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}

	public String getStatus() {
		return status;
	}

	public void setStatus(String status) {
		this.status = status;
	}

	public String getUsuario() {
		return usuario;
	}

	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}

}
