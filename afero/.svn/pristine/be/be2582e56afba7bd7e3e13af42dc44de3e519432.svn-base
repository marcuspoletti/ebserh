package afero.model;

public class TribServico {
	
	private int idTribServico;
	private String sigla;
	private float aliquota;
	private float pRetencao;
	

	public TribServico() {
		
		// TODO Auto-generated constructor stub
	}
	public TribServico(int idTribServico, String sigla, float aliquota,
			float pRetencao) {
		
		this.idTribServico = idTribServico;
		this.sigla = sigla;
		this.aliquota = aliquota;
		this.pRetencao = pRetencao;
	}
	public int getIdTribServico() {
		return idTribServico;
	}
	public void setIdTribServico(int idTribServico) {
		this.idTribServico = idTribServico;
	}
	public String getSigla() {
		return sigla;
	}
	public void setSigla(String sigla) {
		this.sigla = sigla;
	}
	public float getAliquota() {
		return aliquota;
	}
	public void setAliquota(float aliquota) {
		this.aliquota = aliquota;
	}
	public float getpRetencao() {
		return pRetencao;
	}
	public void setpRetencao(float pRetencao) {
		this.pRetencao = pRetencao;
	}
	
	
}
