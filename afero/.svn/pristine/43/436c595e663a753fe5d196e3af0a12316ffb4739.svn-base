package afero.model;

import java.util.Date;

public class OrdemServicoObjeto {
	
	private int idOrdemServicoObjeto;
	private int idOrdemServico;
	private int idListaObjeto;
	private String campo1;
	private String campo2;
	private String campo3;
	private String campo4;
	private String observacao;
	private Date dtGarantia;
	private int nrControle;
	private Date dtMod;
	private String usuario;

	public OrdemServicoObjeto() {
	}
	
	
	public OrdemServicoObjeto(int idOrdemServicoObjeto, int idOrdemServico,
			int idListaObjeto, String campo1, String campo2, String campo3,
			String campo4, String observacao, Date dtGarantia2, int nrControle,
			Date dtMod2, String usuario) {
		super();
		this.idOrdemServicoObjeto = idOrdemServicoObjeto;
		this.idOrdemServico = idOrdemServico;
		this.idListaObjeto = idListaObjeto;
		this.campo1 = campo1;
		this.campo2 = campo2;
		this.campo3 = campo3;
		this.campo4 = campo4;
		this.observacao = observacao;
		this.dtGarantia = dtGarantia2;
		this.nrControle = nrControle;
		this.dtMod = dtMod2;
		this.usuario = usuario;
	}



	public int getIdOrdemServicoObjeto() {
		return idOrdemServicoObjeto;
	}

	public void setIdOrdemServicoObjeto(int idOrdemServicoObjeto) {
		this.idOrdemServicoObjeto = idOrdemServicoObjeto;
	}

	public int getIdOrdemServico() {
		return idOrdemServico;
	}

	public void setIdOrdemServico(int idOrdemServico) {
		this.idOrdemServico = idOrdemServico;
	}

	public int getIdListaObjeto() {
		return idListaObjeto;
	}

	public void setIdListaObjeto(int idListaObjeto) {
		this.idListaObjeto = idListaObjeto;
	}

	public String getCampo1() {
		return campo1;
	}

	public void setCampo1(String campo1) {
		this.campo1 = campo1;
	}

	public String getCampo2() {
		return campo2;
	}

	public void setCampo2(String campo2) {
		this.campo2 = campo2;
	}

	public String getCampo3() {
		return campo3;
	}

	public void setCampo3(String campo3) {
		this.campo3 = campo3;
	}

	public String getCampo4() {
		return campo4;
	}

	public void setCampo4(String campo4) {
		this.campo4 = campo4;
	}

	public String getObservacao() {
		return observacao;
	}

	public void setObservacao(String observacao) {
		this.observacao = observacao;
	}

	public Date getDtGarantia() {
		return dtGarantia;
	}

	public void setDtGarantia(Date dtGarantia) {
		this.dtGarantia = dtGarantia;
	}

	public int getNrControle() {
		return nrControle;
	}

	public void setNrControle(int nrControle) {
		this.nrControle = nrControle;
	}

	public Date getDtMod() {
		return dtMod;
	}

	public void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}

	public String getUsuario() {
		return usuario;
	}

	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}
}