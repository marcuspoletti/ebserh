	public void excluir(PedidoSaida pedidoSaida) throws AferoDAOException {
		PreparedStatement ps = null;
		Connection conn = null;		
		if (pedidoSaida == null)
			throw new AferoDAOException(
					"O valor passado nï¿½o pode ser nulo");

		try {			
			conn = this.conn;
			ps = conn.prepareStatement("DELETE FROM tbpedidoSaida WHERE idPedidoSaida=?");
			ps.setInt(1, pedidoSaida.getIdPedidoSaida());
			ps.executeUpdate();

		} catch (SQLException sqle) {
			throw new AferoDAOException("Erro ao excluir dados:" + sqle);

		} finally {
			//ConnectionFactory.closeConnection(conn, ps);
		}

	}

	public PedidoSaida procurarPedidoSaida(int idPedidoSaida) throws AferoDAOException {
		PreparedStatement ps = null;
		Connection conn = null;
		ResultSet rs = null;
		PedidoSaida pedidoSaida = null;
		
		try {
			String sql = "SELECT idLoja, cdEntidade, idColaborador, idEntrega, operacao, dtPed, "+
			             "vlPed, observacao, anotacao, status, dtMod, usuario, dtEntrega, hrEntrega, dtMov, pessoaResponsavel, cdCondPagto " +
					     "FROM tbpedidosaida " +
					     "WHERE idPedidoSaida = ?";
			conn = this.conn;
			ps = conn.prepareStatement(sql);
			ps.setInt(1, idPedidoSaida);
			rs = ps.executeQuery();
			if (!rs.next()) {
				throw new AferoDAOException("Nï¿½o foi encontrado nenhum "
						+ "registro com o cï¿½digo: " +idPedidoSaida);
			}
			int idLoja = rs.getInt(1);
		    int cdEntidade = rs.getInt(2);
			int idColaborador = rs.getInt(3);
			int idEntrega = rs.getInt(4);
			String operacao = rs.getString(5);
			Date dtPed = rs.getTimestamp(6);
		    double vlPed = rs.getDouble(7);
		    String observacao = rs.getString(8);
		    String anotacao = rs.getString(9);
		    String status = rs.getString(10);
		    Date dtMod = rs.getDate(11);
			String usuario = rs.getString(12);
			Date dtEntrega = rs.getTimestamp(13);
			String hrEntrega = rs.getString(14);
			Date dtMov = rs.getDate(15);
			String pessoaResponsavel = rs.getString(16);
			int cdCondPagto = rs.getInt(17);

		    pedidoSaida = new PedidoSaida(idPedidoSaida, idLoja, cdEntidade,
					idColaborador, idEntrega, operacao, dtPed,
					vlPed, observacao, anotacao, status, dtMod, usuario, 
					dtEntrega, hrEntrega, dtMov, pessoaResponsavel, cdCondPagto);

		} catch (SQLException sqle) {
			throw new AferoDAOException(sqle);
		} finally {
			//ConnectionFactory.closeConnection(conn, ps, rs);
		}
		return pedidoSaida;
	}
	
