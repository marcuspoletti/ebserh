	public List listarPedidoOrdemServico(int idOrdemServico, int cdLoja) throws AferoDAOException {
		PreparedStatement ps = null;
		Connection conn = null;
		ResultSet rs = null;
		List<PedidoSaida> list = null;
		
		try {
			String sql = "SELECT  ps.idPedidoSaida, ps.idLoja, ps.cdEntidade, ps.idColaborador, ps.idEntrega, ps.operacao, ps.dtPed, "+ 
			                     "ps.vlPed, ps.observacao, ps.anotacao, ps.status, ps.dtMod, ps.usuario, ps.dtEntrega, ps.hrEntrega, ps.dtMov, "+
			                     "ps.pessoaResponsavel, ps.vlDesc, ps.cdCondPagto, ps.tipoPedido "+
			                     "FROM tbpedidosaida ps "+
			                     "Join tbordemservico e on (ps.idOrdemServico = e.idOrdemServico) "+
			                     "WHERE e.idOrdemServico = ? AND e.idLoja = ? AND ps.status = 'P' ";
			
			conn = this.conn;
			ps = conn.prepareStatement(sql);
			ps.setInt(1, idOrdemServico);
			ps.setInt(2, cdLoja);
			rs = ps.executeQuery();
			list = new ArrayList<PedidoSaida>();
			while (rs.next()) {
				int idPedidoSaida = rs.getInt(1);
				int idLoja = rs.getInt(2);
			    int cdEntidade = rs.getInt(3);
				int idColaborador = rs.getInt(4);
				int idEntrega = rs.getInt(5);
				String operacao = rs.getString(6);
				Date dtPed = rs.getTimestamp(7);
			    double vlPed = rs.getDouble(8);
			    String observacao = rs.getString(9);
			    String anotacao = rs.getString(10);
			    String status = rs.getString(11);
			    Date dtMod = rs.getDate(12);
				String usuario = rs.getString(13);
				Date dtEntrega = rs.getTimestamp(14);
				String hrEntrega = rs.getString(15);
				Date dtMov = rs.getDate(16);
				String pessoaResponsavel = rs.getString(17);
				float vlDesc = rs.getFloat(18);
				int cdCondPagto = rs.getInt(19);
				String tipoPedido = rs.getString(20);
				list.add(new PedidoSaida(idPedidoSaida, idLoja, cdEntidade,
						idColaborador, idEntrega, operacao, dtPed,
						vlPed, observacao, anotacao, status, dtMod, usuario, 
						dtEntrega, hrEntrega, dtMov, pessoaResponsavel, cdCondPagto, tipoPedido));
				

			}

		} catch (SQLException sqle) {
			throw new AferoDAOException(sqle);
		} 
		return list;
	}
	
	public int ProcurarOrdemDeServico(int idPedidoSaida, int idLoja) throws AferoDAOException {
		PreparedStatement ps = null;
		Connection conn = null;
		ResultSet rs = null;
		int idOrdemServico = 0;
		
		try {
			String sql = "SELECT  ps.idOrdemServico, ps.idPedidoSaida, ps.idLoja, ps.cdEntidade, ps.idColaborador, ps.idEntrega, ps.operacao, ps.dtPed, "+ 
			                     "ps.vlPed, ps.observacao, ps.anotacao, ps.status, ps.dtMod, ps.usuario, ps.dtEntrega, ps.hrEntrega, ps.dtMov, "+
			                     "ps.pessoaResponsavel, ps.vlDesc, ps.cdCondPagto, ps.tipoPedido "+
			                     "FROM tbpedidosaida ps "+
			                     "Join tbordemservico e on (ps.idOrdemServico = e.idOrdemServico) "+
			                     "WHERE ps.idPedidoSaida = ? AND e.idLoja = ? AND ps.status = 'P' ";
			
			conn = this.conn;
			ps = conn.prepareStatement(sql);
			ps.setInt(1, idPedidoSaida);
			ps.setInt(2, idLoja);
			rs = ps.executeQuery();
			while (rs.next()) {
				idOrdemServico = rs.getInt(1);

			}

		} catch (SQLException sqle) {
