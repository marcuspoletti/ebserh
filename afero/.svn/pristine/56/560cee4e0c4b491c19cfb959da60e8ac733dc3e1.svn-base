	public List vendasGrupos(String clausula) throws AferoDAOException {
		PreparedStatement ps = null;
		Connection conn = null;
		ResultSet rs = null;
		List<VendasGrupos> list = null;
		
		try {
			String sql = "SELECT g.idGrupo, g.dsGrupo, sum(psi.quant*psi.VlUni), sum(psi.quant) "+
						  "FROM tbgrupo g "+
						  "JOIN tbproduto p on (g.idGrupo = p.idGrupo) "+
						  "JOIN tbpedidosaidaitem psi on (p.idProduto = psi.idProduto) "+
						  "JOIN tbpedidosaida ps on (psi.idPedidoSaida = ps.idPedidoSaida)";
                        
 
			if (clausula != null) sql = sql + clausula;			
			conn = this.conn; 
			ps = conn.prepareStatement(sql);
			rs = ps.executeQuery();
			list = new ArrayList<VendasGrupos>();
			while (rs.next()) {
				int idGrupo = rs.getInt(1);
				String dsGrupo = rs.getString(2);
				float valor  = rs.getFloat(3);
				int quantItens = rs.getInt(4);
				list.add(new VendasGrupos(dsGrupo, valor, quantItens, idGrupo));

			}

		} catch (SQLException sqle) {
			throw new AferoDAOException(sqle);
		} 
		return list;
	}
	public boolean existePedidoMesa(int idMesa) throws AferoDAOException {
		PreparedStatement ps = null;
		Connection conn = null;
		ResultSet rs = null;
		boolean idPedido = false;
		
		try {
			String sql = "select ps.idPedidoSaida "+
			             "from tbpedidosaida ps "+
			             "join tbmesa m on (ps.idMesa = m.idMesa) "+
                         "where ps.status='P' AND m.idMesa = ?";
			conn = this.conn;
			ps = conn.prepareStatement(sql);
			ps.setInt(1, idMesa);
			rs = ps.executeQuery();
			if (rs.next()) {
				idPedido =true;
			}

		} catch (SQLException sqle) {
			throw new AferoDAOException(sqle);
		} 
		return idPedido;
	}
	public String procurarPedidoMesa(int idMesa) throws AferoDAOException {
		PreparedStatement ps = null;
		Connection conn = null;
		ResultSet rs = null;
		String idPedido = "0";
		
		try {
			String sql = "select ps.idPedidoSaida "+
			             "from tbpedidosaida ps "+
			             "join tbmesa m on (ps.idMesa = m.idMesa) "+
                         "where ps.status='P' AND m.idMesa = ?";
			conn = this.conn;
			ps = conn.prepareStatement(sql);
			ps.setInt(1, idMesa);
			rs = ps.executeQuery();
			if (rs.next()) {
				idPedido =String.valueOf(rs.getInt(1));
			}else{
				idPedido = "0";
			}

		} catch (SQLException sqle) {
			throw new AferoDAOException(sqle);
		} 
		return idPedido;
	}
	public String duracaoDoPedido(int idMesa) throws AferoDAOException {
		PreparedStatement ps = null;
		Connection conn = null;
		ResultSet rs = null;
		String duracao = "00:00:00";
		String hora = "";
		String minuto = "";
		String segundo = "";
		MesaDAO daoMesa = new MesaDAO(this.conn);
		String status = daoMesa.statusMesa(idMesa);
		if(status.equalsIgnoreCase("C")){
			try {
				String sql = " SELECT  HOUR(TIMEDIFF(now(), ps.dtPed)), MINUTE (TIMEDIFF(now(), ps.dtPed)), SECOND(TIMEDIFF(now(), ps.dtPed)) from tbpedidosaida ps "+
				             " WHERE ps.idPedidoSaida = ? AND ps.status = 'P' AND ps.tipoPedido = 'PM' LIMIT 1 ";
				conn = this.conn;
				ps = conn.prepareStatement(sql);
				String idPedido = procurarPedidoMesa(idMesa);
				ps.setInt(1, Integer.parseInt(idPedido));
				rs = ps.executeQuery();
				if (rs.next()) {
					hora = String.valueOf(rs.getInt(1));
					minuto = String.valueOf(rs.getInt(2));
					segundo = String.valueOf(rs.getInt(3));
					duracao = hora+":"+minuto+":"+segundo;
				}
	
			} catch (Exception sqle) {
				throw new AferoDAOException(sqle);
			} 
		}
		return duracao;
	}
	public List vendasGruposCondicaoPagamento(String clausula) throws AferoDAOException {
		PreparedStatement ps = null;
		Connection conn = null;
		ResultSet rs = null;
		List<VendasGrupoCondicaoPagamento> list = null;
		
		try {
			String sql = "SELECT ps.cdCondPagto, cp.dsCondPagto, sum(psi.quant*psi.VlUni) "+
						  "FROM tbgrupo g "+
						  "JOIN tbproduto p on (g.idGrupo = p.idGrupo) "+
						  "JOIN tbpedidosaidaitem psi on (p.idProduto = psi.idProduto) "+
						  "JOIN tbpedidosaida ps on (psi.idPedidoSaida = ps.idPedidoSaida) "+
						  "JOIN tbcondpagto cp on (ps.cdCondPagto = cp.cdCondPagto)";
                        
 
			if (clausula != null) sql = sql + clausula;			
			conn = this.conn; 
			ps = conn.prepareStatement(sql);
			rs = ps.executeQuery();
			list = new ArrayList<VendasGrupoCondicaoPagamento>();
			while (rs.next()) {
				int cdCondPagto = rs.getInt(1);
				String dsCondPagto  = rs.getString(2);
				double valor = rs.getDouble(3);
				list.add(new VendasGrupoCondicaoPagamento(cdCondPagto, dsCondPagto, valor));

			}

		} catch (SQLException sqle) {
			throw new AferoDAOException(sqle);
		} 
		return list;
	}
