	public Integer getQuantItensPedido(int idPedidoSaida) throws AferoDAOException {
		PreparedStatement ps = null;
		Connection conn = null;
		ResultSet rs = null;
		Integer quantItens = 0;
		
		try {
			String sql = " Select count(i.idPedidoSaidaItem) "+
						 " From tbpedidosaida p "+
						 " JOIN tbpedidosaidaitem i on p.idPedidoSaida = i.idPedidoSaida "+
						 " WHERE p.idPedidoSaida = ? ";
			conn = this.conn;
			ps = conn.prepareStatement(sql);
			ps.setInt(1, idPedidoSaida);
			rs = ps.executeQuery();
			if (rs.next()) {
				quantItens =rs.getInt(1);
			}else{
				quantItens = 0;
			}

		} catch (SQLException sqle) {
			throw new AferoDAOException(sqle);
		} 
		return quantItens;
	}
