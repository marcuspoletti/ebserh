	public void atualizarContasReceber(PedidoSaida pedidoSaida) throws AferoDAOException {
		Integer idDuplicataPai = 0;
		Duplicata duplicata = new Duplicata();
		DuplicataDAO daoDuplicata = new DuplicataDAO(conn);
		DuplicataParcela duplicataParcela = new DuplicataParcela();
		DuplicataParcelaDAO daoDuplicataParcela = new DuplicataParcelaDAO(conn);
		Entrega entrega = null;
		if (pedidoSaida == null)
			throw new AferoDAOException("O valor passado não pode ser nulo");

		try {		
			if(pedidoSaida.getIdEntrega() != 0){
				EntregaDAO daoEntrega = new EntregaDAO(conn);
				entrega = daoEntrega.procurarEntrega(pedidoSaida.getIdEntrega());
			}
			duplicata.setIdLoja(pedidoSaida.getIdLoja());
			duplicata.setCdEntidade(pedidoSaida.getCdEntidade());
			duplicata.setDc("C");
			duplicata.setDtEmissao(pedidoSaida.getDtPed());
			if(entrega != null){
				duplicata.setValorTotal(pedidoSaida.getVlPed() + entrega.getTxEntrega());
			}else{
				duplicata.setValorTotal(pedidoSaida.getVlPed());
			}
			
			duplicata.setObservacao("Numero do Pedido = "+pedidoSaida.getIdPedidoSaida());
			duplicata.setNrDoc("".valueOf(pedidoSaida.getIdPedidoSaida()));
			duplicata.setStatus("A");
			duplicata.setUsuario(pedidoSaida.getUsuario());
			duplicata.setGerarBoleto("N");
			duplicata.setTipoLancamento("A");
			duplicata.setQuantParcelas(1);
			duplicata.setTipoJuros("M");
			daoDuplicata.incluirDuplicataPedidoSaida(duplicata);
			idDuplicataPai = daoDuplicata.idDuplicataMax();
			duplicata.setIdDuplicata(idDuplicataPai);
			daoDuplicata.atualizarPedidoSaida(duplicata);
			
			duplicataParcela.setIdDuplicata(idDuplicataPai);
			duplicataParcela.setDtVenc(duplicata.getDtEmissao());
			duplicataParcela.setValor(duplicata.getValorTotal());
			duplicataParcela.setDtEmissao(duplicata.getDtEmissao());
			duplicataParcela.setNrDoc(duplicata.getNrDoc());
			duplicataParcela.setStatus("A");
			duplicataParcela.setUsuario(duplicata.getUsuario());
			duplicataParcela.setHistorico("Numero do Pedido = "+pedidoSaida.getIdPedidoSaida());
			daoDuplicataParcela.incluirContasReceber(duplicataParcela);

		} catch (Exception e) {
			throw new AferoDAOException("Erro ao inserir dados: " + e);
		} 
	}
	
	
}
