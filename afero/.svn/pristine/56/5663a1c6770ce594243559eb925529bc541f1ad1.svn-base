package afero.model;

import java.util.Date;

public class PedidoSaidaSubItens {
	
	private int idPedidoSaidaSubItem;
	private int idPedidoSaidaItem;
	private int idProduto;
	private int idUnidade;
	private float comp;
	private float larg;
	private float quant;
	private float pDesc;
	private float vlUni;
	private Date dtMod;
	private String usuario;
	
	//Atualização Pizzaria
	private String dsCompProduto;

	public PedidoSaidaSubItens() {
	}
	
	public PedidoSaidaSubItens(int idPedidoSaidaSubItem, int idPedidoSaidaItem,
			int idProduto, int idUnidade, float comp, float larg, float quant,
			float pDesc, float vlUni, Date dtMod, String usuario) {
		super();
		this.idPedidoSaidaSubItem = idPedidoSaidaSubItem;
		this.idPedidoSaidaItem = idPedidoSaidaItem;
		this.idProduto = idProduto;
		this.idUnidade = idUnidade;
		this.comp = comp;
		this.larg = larg;
		this.quant = quant;
		this.pDesc = pDesc;
		this.vlUni = vlUni;
		this.dtMod = dtMod;
		this.usuario = usuario;
	}
	
	public PedidoSaidaSubItens(int idPedidoSaidaSubItem, int idPedidoSaidaItem,
			int idProduto, int idUnidade, String dsCompProduto, float comp, float larg, float quant,
			float pDesc, float vlUni, Date dtMod, String usuario) {
		super();
		this.idPedidoSaidaSubItem = idPedidoSaidaSubItem;
		this.idPedidoSaidaItem = idPedidoSaidaItem;
		this.idProduto = idProduto;
		this.idUnidade = idUnidade;
		this.dsCompProduto = dsCompProduto;
		this.comp = comp;
		this.larg = larg;
		this.quant = quant;
		this.pDesc = pDesc;
		this.vlUni = vlUni;
		this.dtMod = dtMod;
		this.usuario = usuario;
	}

	public int getIdPedidoSaidaSubItem() {
		return idPedidoSaidaSubItem;
	}

	public void setIdPedidoSaidaSubItem(int idPedidoSaidaSubItem) {
		this.idPedidoSaidaSubItem = idPedidoSaidaSubItem;
	}

	public int getIdPedidoSaidaItem() {
		return idPedidoSaidaItem;
	}

	public void setIdPedidoSaidaItem(int idPedidoSaidaItem) {
		this.idPedidoSaidaItem = idPedidoSaidaItem;
	}

	public int getIdProduto() {
		return idProduto;
	}

	public void setIdProduto(int idProduto) {
		this.idProduto = idProduto;
	}

	public int getIdUnidade() {
		return idUnidade;
	}

	public void setIdUnidade(int idUnidade) {
		this.idUnidade = idUnidade;
	}

	public float getComp() {
		return comp;
	}

	public void setComp(float comp) {
		this.comp = comp;
	}

	public float getLarg() {
		return larg;
	}

	public void setLarg(float larg) {
		this.larg = larg;
	}

	public float getQuant() {
		return quant;
	}

	public void setQuant(float quant) {
		this.quant = quant;
	}

	public float getpDesc() {
		return pDesc;
	}

	public void setpDesc(float pDesc) {
		this.pDesc = pDesc;
	}

	public float getVlUni() {
		return vlUni;
	}

	public void setVlUni(float vlUni) {
		this.vlUni = vlUni;
	}

	public Date getDtMod() {
		return dtMod;
	}

	public void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}

	public String getUsuario() {
		return usuario;
	}

	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}

	public String getDsCompProduto() {
		return dsCompProduto;
	}

	public void setDsCompProduto(String dsCompProduto) {
		this.dsCompProduto = dsCompProduto;
	}
	
	
	
}
