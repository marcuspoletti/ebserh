package afero.model;

public class TipoNivel {

	private int cdTipoNivel;
	private String dsTipoNivel;
	private String status;

	public TipoNivel() {

	}

	public TipoNivel(int cdTipoNivel, String dsTipoNivel, String status) {
		this.cdTipoNivel = cdTipoNivel;
		this.dsTipoNivel = dsTipoNivel;
		this.status = status;
	}

	public final int getCdTipoNivel() {
		return cdTipoNivel;
	}

	public final void setCdTipoNivel(int cdTipoNivel) {
		this.cdTipoNivel = cdTipoNivel;
	}

	public final String getDsTipoNivel() {
		return dsTipoNivel;
	}

	public final void setDsTipoNivel(String dsTipoNivel) {
		this.dsTipoNivel = dsTipoNivel;
	}

	public final String getStatus() {
		return status;
	}

	public final void setStatus(String status) {
		this.status = status;
	}
	
}
