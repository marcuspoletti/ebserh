package afero.model;

import java.util.Date;

public class ListaServico {
	
	private int idListaServico;
	private int idLoja;
	private String dsListaServico;
	private int cdListaServico;
	private float preco;
	private int idUnidade;
	private String status;
	private Date dtCad;
	private Date dtMod;
	private String usuario;
	
	public ListaServico() {
	}

	public ListaServico(int idListaServico, int idLoja, String dsListaServico,
			int cdListaServico, float preco, int idUnidade, String status,
			Date dtCad, Date dtMod, String usuario) {
		super();
		this.idListaServico = idListaServico;
		this.idLoja = idLoja;
		this.dsListaServico = dsListaServico;
		this.cdListaServico = cdListaServico;
		this.preco = preco;
		this.idUnidade = idUnidade;
		this.status = status;
		this.dtCad = dtCad;
		this.dtMod = dtMod;
		this.usuario = usuario;
	}

	public int getIdListaServico() {
		return idListaServico;
	}

	public void setIdListaServico(int idListaServico) {
		this.idListaServico = idListaServico;
	}

	public int getIdLoja() {
		return idLoja;
	}

	public void setIdLoja(int idLoja) {
		this.idLoja = idLoja;
	}

	public String getDsListaServico() {
		return dsListaServico;
	}

	public void setDsListaServico(String dsListaServico) {
		this.dsListaServico = dsListaServico;
	}

	public int getCdListaServico() {
		return cdListaServico;
	}

	public void setCdListaServico(int cdListaServico) {
		this.cdListaServico = cdListaServico;
	}

	public float getPreco() {
		return preco;
	}

	public void setPreco(float preco) {
		this.preco = preco;
	}

	public int getIdUnidade() {
		return idUnidade;
	}

	public void setIdUnidade(int idUnidade) {
		this.idUnidade = idUnidade;
	}

	public String getStatus() {
		return status;
	}

	public void setStatus(String status) {
		this.status = status;
	}

	public Date getDtCad() {
		return dtCad;
	}

	public void setDtCad(Date dtCad) {
		this.dtCad = dtCad;
	}

	public Date getDtMod() {
		return dtMod;
	}

	public void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}

	public String getUsuario() {
		return usuario;
	}

	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}
	
}