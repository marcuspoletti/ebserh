package afero.model;

public class TipoFrequencia {
	
	private int cdTipoFrequencia = 0;
	private String dsTipoFrequencia = "";
	private String status = "";
	
	public TipoFrequencia(){
		
	}
	
	public TipoFrequencia(int cdTipoFrequencia, String dsTipoFrequencia,String status){
		this.cdTipoFrequencia = cdTipoFrequencia;
		this.dsTipoFrequencia = dsTipoFrequencia;
		this.status = status;
	}
	public int getCdTipoFrequencia(){
		return this.cdTipoFrequencia;
	}
	
	public String getDsTipoFrequencia(){
		return this.dsTipoFrequencia;
	}
	public String getStatus(){
		return this.status;
	}
	public void setCdTipoFrequencia(int cdTipoFrequencia){
		this.cdTipoFrequencia = cdTipoFrequencia;
	}
	public void setDsTipoFrequencia(String dsTipoFrequencia){
		this.dsTipoFrequencia = dsTipoFrequencia;
	}
	public void setStatus(String status){
		this.status = status;
	}

}
