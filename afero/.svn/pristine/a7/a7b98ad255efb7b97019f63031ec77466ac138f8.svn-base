package afero.model;

public class SubRelatorioOrdemServicoProduto {
	
	private float quant= 0;
	private String descProduto = "";
	private float desc = 0;
	private float vlUnit =0;
	private float totalItem = 0;
	private String und = "";
	
	
	

	public SubRelatorioOrdemServicoProduto() {
		
	}




	public SubRelatorioOrdemServicoProduto(float quant, String descProduto,
			float desc, float vlUnit, float totalItem, String und) {
		
		this.quant = quant;
		this.descProduto = descProduto;
		this.desc = desc;
		this.vlUnit = vlUnit;
		this.totalItem = totalItem;
		this.und = und;
	}




	public float getQuant() {
		return quant;
	}




	public void setQuant(float quant) {
		this.quant = quant;
	}




	public String getDescProduto() {
		return descProduto;
	}




	public void setDescProduto(String descProduto) {
		this.descProduto = descProduto;
	}




	public float getDesc() {
		return desc;
	}




	public void setDesc(float desc) {
		this.desc = desc;
	}




	public float getVlUnit() {
		return vlUnit;
	}




	public void setVlUnit(float vlUnit) {
		this.vlUnit = vlUnit;
	}




	public float getTotalItem() {
		return totalItem;
	}




	public void setTotalItem(float totalItem) {
		this.totalItem = totalItem;
	}




	public String getUnd() {
		return und;
	}




	public void setUnd(String und) {
		this.und = und;
	}


	
	
	
	

}
