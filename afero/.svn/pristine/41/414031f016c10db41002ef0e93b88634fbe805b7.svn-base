package afero.model;

import java.util.Date;

public class EntidadeTelefone {

	private int idEntidadeTelefone;
	private int cdEntidade;
	private int cdTipoTelefone;
	private String nroTelefone;
	private String ramTelefone;
	private String padrao;
	private Date dtMod;
	private String usuario;

	public EntidadeTelefone() {

	}

	public EntidadeTelefone(int idEntidadeTelefone, int cdEntidade, int cdTipoTelefone,
			String nroTelefone, String ramTelefone, String padrao, Date dtMod,
			String usuario) {
		this.idEntidadeTelefone = idEntidadeTelefone;
		this.cdEntidade = cdEntidade;
		this.cdTipoTelefone = cdTipoTelefone;
		this.nroTelefone = nroTelefone;
		this.ramTelefone = ramTelefone;
		this.padrao = padrao;
		this.dtMod = dtMod;
		this.usuario = usuario;
	}

	public final int getIdEntidadeTelefone() {
		return idEntidadeTelefone;
	}

	public final void setIdEntidadeTelefone(int idEntidadeTelefone) {
		this.idEntidadeTelefone = idEntidadeTelefone;
	}

	public final int getCdEntidade() {
		return cdEntidade;
	}

	public final void setCdEntidade(int cdEntidade) {
		this.cdEntidade = cdEntidade;
	}

	public final int getCdTipoTelefone() {
		return cdTipoTelefone;
	}

	public final void setCdTipoTelefone(int cdTipoTelefone) {
		this.cdTipoTelefone = cdTipoTelefone;
	}

	public final String getNroTelefone() {
		return nroTelefone;
	}

	public final void setNroTelefone(String nroTelefone) {
		this.nroTelefone = nroTelefone;
	}

	public final String getRamTelefone() {
		return ramTelefone;
	}

	public final void setRamTelefone(String ramTelefone) {
		this.ramTelefone = ramTelefone;
	}

	public final String getPadrao() {
		return padrao;
	}

	public final void setPadrao(String padrao) {
		this.padrao = padrao;
	}

	public final Date getDtMod() {
		return dtMod;
	}

	public final void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}

	public final String getUsuario() {
		return usuario;
	}

	public final void setUsuario(String usuario) {
		this.usuario = usuario;
	}
	
}
