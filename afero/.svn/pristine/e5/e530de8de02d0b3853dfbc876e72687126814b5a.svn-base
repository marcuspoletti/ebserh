package afero.model;

import java.util.*;


public class Conta {
	
	private int idConta = 0;
	private int idLoja = 0;
	private String nmConta = "";
	private int idTipoConta = 0;
	private int idBanco = 0;
	private String agencia = "";
	private String contaCorrente = "";
	private float vlLimiteCredito = 0;
	private Date dtVencLimite = null;
	private Date dtSaldoAbertura = null;
	private float vlSaldoAbertura = 0;
	private String paginaInicial = "";
	private String status = "";
	private String pessoaContato = "";
	private String nroTelefone = "";
	private String email = "";
	private String site = "";
	private String observacao = "";
	private Date dtSaldoAtual = null;
	private float vlSaldoAtual = 0;
	private Date dtSaldoConciliado = null;
	private float vlSaldoConciliado = 0;
	private Date dtCad = null;
	private Date dtMod = null;
	private String usuario = "";
	
	public Conta() {
		
		// TODO Auto-generated constructor stub
	}
	public Conta(int idConta, int idLoja, String nmConta, int idTipoConta,
			int idBanco, String agencia, String contaCorrente,
			float vlLimiteCredito, Date dtVencLimite, Date dtSaldoAbertura,
			float vlSaldoAbertura, String paginaInicial, String status,
			String pessoaContato, String nroTelefone, String email,
			String site, String observacao, Date dtSaldoAtual, float vlSaldoAtual,
			Date dtSaldoConciliado, float vlSaldoConciliado,
			Date dtCad, Date dtMod,
			String usuario) {
		this.idConta = idConta;
		this.idLoja = idLoja;
		this.nmConta = nmConta;
		this.idTipoConta = idTipoConta;
		this.idBanco = idBanco;
		this.agencia = agencia;
		this.contaCorrente = contaCorrente;
		this.vlLimiteCredito = vlLimiteCredito;
		this.dtVencLimite = dtVencLimite;
		this.dtSaldoAbertura = dtSaldoAbertura;
		this.vlSaldoAbertura = vlSaldoAbertura;
		this.paginaInicial = paginaInicial;
		this.status = status;
		this.pessoaContato = pessoaContato;
		this.nroTelefone = nroTelefone;
		this.email = email;
		this.site = site;
		this.observacao = observacao;
		this.dtSaldoAtual = dtSaldoAtual;
		this.vlSaldoAtual = vlSaldoAtual;
		this.dtSaldoConciliado = dtSaldoConciliado;
		this.vlSaldoConciliado = vlSaldoConciliado;
		this.dtCad = dtCad;
		this.dtMod = dtMod;
		this.usuario = usuario;
	}
	
	public int getIdConta() {
		return idConta;
	}
	public void setIdConta(int idConta) {
		this.idConta = idConta;
	}
	public int getIdLoja() {
		return idLoja;
	}
	public void setIdLoja(int idLoja) {
		this.idLoja = idLoja;
	}
	public String getNmConta() {
		return nmConta;
	}
	public void setNmConta(String nmConta) {
		this.nmConta = nmConta;
	}
	public int getIdTipoConta() {
		return idTipoConta;
	}
	public void setIdTipoConta(int idTipoConta) {
		this.idTipoConta = idTipoConta;
	}
	public int getIdBanco() {
		return idBanco;
	}
	public void setIdBanco(int idBanco) {
		this.idBanco = idBanco;
	}
	public String getAgencia() {
		return agencia;
	}
	public void setAgencia(String agencia) {
		this.agencia = agencia;
	}
	public String getContaCorrente() {
		return contaCorrente;
	}
	public void setContaCorrente(String contaCorrente) {
		this.contaCorrente = contaCorrente;
	}
	public float getVlLimiteCredito() {
		return vlLimiteCredito;
	}
	public void setVlLimiteCredito(float vlLimiteCredito) {
		this.vlLimiteCredito = vlLimiteCredito;
	}
	public Date getDtVencLimite() {
		return dtVencLimite;
	}
	public void setDtVencLimite(Date dtVencLimite) {
		this.dtVencLimite = dtVencLimite;
	}
	public Date getDtSaldoAbertura() {
		return dtSaldoAbertura;
	}
	public void setDtSaldoAbertura(Date dtSaldoAbertura) {
		this.dtSaldoAbertura = dtSaldoAbertura;
	}
	public float getVlSaldoAbertura() {
		return vlSaldoAbertura;
	}
	public void setVlSaldoAbertura(float vlSaldoAbertura) {
		this.vlSaldoAbertura = vlSaldoAbertura;
	}
	public String getPaginaInicial() {
		return paginaInicial;
	}
	public void setPaginaInicial(String paginaInicial) {
		this.paginaInicial = paginaInicial;
	}
	public String getStatus() {
		return status;
	}
	public void setStatus(String status) {
		this.status = status;
	}
	public String getPessoaContato() {
		return pessoaContato;
	}
	public void setPessoaContato(String pessoaContato) {
		this.pessoaContato = pessoaContato;
	}
	public String getNroTelefone() {
		return nroTelefone;
	}
	public void setNroTelefone(String nroTelefone) {
		this.nroTelefone = nroTelefone;
	}
	public String getEmail() {
		return email;
	}
	public void setEmail(String email) {
		this.email = email;
	}
	public String getSite() {
		return site;
	}
	public void setSite(String site) {
		this.site = site;
	}
	public String getObservacao() {
		return observacao;
	}
	public void setObservacao(String observacao) {
		this.observacao = observacao;
	}
	public Date getDtSaldoAtual() {
		return dtSaldoAtual;
	}
	public void setDtSaldoAtual(Date dtSaldoAtual) {
		this.dtSaldoAtual = dtSaldoAtual;
	}
	public float getVlSaldoAtual() {
		return vlSaldoAtual;
	}
	public void setVlSaldoAtual(float vlSaldoAtual) {
		this.vlSaldoAtual = vlSaldoAtual;
	}
	public Date getDtSaldoConciliado() {
		return dtSaldoConciliado;
	}
	public void setDtSaldoConciliado(Date dtSaldoConciliado) {
		this.dtSaldoConciliado = dtSaldoConciliado;
	}
	public float getVlSaldoConciliado() {
		return vlSaldoConciliado;
	}
	public void setVlSaldoConciliado(float vlSaldoConciliado) {
		this.vlSaldoConciliado = vlSaldoConciliado;
	}
	public Date getDtCad() {
		return dtCad;
	}
	public void setDtCad(Date dtCad) {
		this.dtCad = dtCad;
	}
	public Date getDtMod() {
		return dtMod;
	}
	public void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}
	public String getUsuario() {
		return usuario;
	}
	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}

}
