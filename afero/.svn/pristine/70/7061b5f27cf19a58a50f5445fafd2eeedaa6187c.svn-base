package afero.model;

public class TipoEndereco {

	private int cdTipoEndereco;
	private String dsTipoEndereco;
	private String status;

	public TipoEndereco() {

	}

	public TipoEndereco(int cdTipoEndereco, String dsTipoEndereco, String status) {
		this.cdTipoEndereco = cdTipoEndereco;
		this.dsTipoEndereco = dsTipoEndereco;
		this.status = status;
	}

	public final int getCdTipoEndereco() {
		return cdTipoEndereco;
	}

	public final void setCdTipoEndereco(int cdTipoEndereco) {
		this.cdTipoEndereco = cdTipoEndereco;
	}

	public final String getDsTipoEndereco() {
		return dsTipoEndereco;
	}

	public final void setDsTipoEndereco(String dsTipoEndereco) {
		this.dsTipoEndereco = dsTipoEndereco;
	}

	public final String getStatus() {
		return status;
	}

	public final void setStatus(String status) {
		this.status = status;
	}	
	
}
