package afero.model;

import java.util.Date;

public class EntidadeDependente {

	private int idEntidadeDependente;
	private int cdEntidade;
	private int idTipoDependente;
	private String nmDependente;
	private Date dtNascimento;
	private String sexo;
	private String status;
	private Date dtMod;
	private String usuario;

	public EntidadeDependente() {

	}

	public EntidadeDependente(int idEntidadeDependente, int cdEntidade,
			int idTipoDependente, String nmDependente, Date dtNascimento,
			String sexo, String status, Date dtMod, String usuario) {
		this.idEntidadeDependente = idEntidadeDependente;
		this.cdEntidade = cdEntidade;
		this.idTipoDependente = idTipoDependente;
		this.nmDependente = nmDependente;
		this.dtNascimento = dtNascimento;
		this.sexo = sexo;
		this.status = status;
		this.dtMod = dtMod;
		this.usuario = usuario;
	}

	public final int getIdEntidadeDependente() {
		return idEntidadeDependente;
	}

	public final void setIdEntidadeDependente(int idEntidadeDependente) {
		this.idEntidadeDependente = idEntidadeDependente;
	}

	public final int getCdEntidade() {
		return cdEntidade;
	}

	public final void setCdEntidade(int cdEntidade) {
		this.cdEntidade = cdEntidade;
	}

	public final int getIdTipoDependente() {
		return idTipoDependente;
	}

	public final void setIdTipoDependente(int idTipoDependente) {
		this.idTipoDependente = idTipoDependente;
	}

	public final String getNmDependente() {
		return nmDependente;
	}

	public final void setNmDependente(String nmDependente) {
		this.nmDependente = nmDependente;
	}

	public final Date getDtNascimento() {
		return dtNascimento;
	}

	public final void setDtNascimento(Date dtNascimento) {
		this.dtNascimento = dtNascimento;
	}

	public final String getSexo() {
		return sexo;
	}

	public final void setSexo(String sexo) {
		this.sexo = sexo;
	}

	public final String getStatus() {
		return status;
	}

	public final void setStatus(String status) {
		this.status = status;
	}

	public final Date getDtMod() {
		return dtMod;
	}

	public final void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}

	public final String getUsuario() {
		return usuario;
	}

	public final void setUsuario(String usuario) {
		this.usuario = usuario;
	}
	
}
