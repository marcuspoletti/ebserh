package afero.model;

public class PlanoConta {
	
	private int idPlanoConta = 0;
	private int idPlanoContaPai = 0;
	private String cdPlanoConta = "";
	private String nmPlanoConta = "";
	private String dc = "";
	private String status = "";
	
	
	public PlanoConta() {
		
		// TODO Auto-generated constructor stub
	}
	
	public PlanoConta(int idPlanoConta, int idPlanoContaPai,
			String cdPlanoConta, String nmPlanoConta, String dc, String status) {
		this.idPlanoConta = idPlanoConta;
		this.idPlanoContaPai = idPlanoContaPai;
		this.cdPlanoConta = cdPlanoConta;
		this.nmPlanoConta = nmPlanoConta;
		this.dc = dc;
		this.status = status;
	}

	public int getIdPlanoConta() {
		return idPlanoConta;
	}
	public void setIdPlanoConta(int idPlanoConta) {
		this.idPlanoConta = idPlanoConta;
	}
	public int getIdPlanoContaPai() {
		return idPlanoContaPai;
	}
	public void setIdPlanoContaPai(int idPlanoContaPai) {
		this.idPlanoContaPai = idPlanoContaPai;
	}
	public String getNmPlanoConta() {
		return nmPlanoConta;
	}
	public void setNmPlanoConta(String nmPlanoConta) {
		this.nmPlanoConta = nmPlanoConta;
	}
	public String getDc() {
		return dc;
	}
	
	public String getStatus() {
		return status;
	}
	public void setStatus(String status) {
		this.status = status;
	}
	public String getCdPlanoConta() {
		return cdPlanoConta;
	}
	public void setCdPlanoConta(String cdPlanoConta) {
		this.cdPlanoConta = cdPlanoConta;
	}
	public void setDc(String dc) {
		this.dc = dc;
	}

}
