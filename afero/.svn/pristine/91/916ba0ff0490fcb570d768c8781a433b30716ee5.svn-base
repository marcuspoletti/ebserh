package afero.model;

public class ListaObjeto {
	
	private int idListaObjeto;
	private int idLoja;
	private String dsListaObjeto;
	private String campo1;
	private String campo2;
	private String campo3;
	private String campo4;
	private String status;

	public ListaObjeto() {
	}

	public ListaObjeto(int idListaObjeto, int idLoja, String dsListaObjeto,
			String campo1, String campo2, String campo3, String campo4,
			String status) {
		super();
		this.idListaObjeto = idListaObjeto;
		this.idLoja = idLoja;
		this.dsListaObjeto = dsListaObjeto;
		this.campo1 = campo1;
		this.campo2 = campo2;
		this.campo3 = campo3;
		this.campo4 = campo4;
		this.status = status;
	}

	public int getIdListaObjeto() {
		return idListaObjeto;
	}

	public void setIdListaObjeto(int idListaObjeto) {
		this.idListaObjeto = idListaObjeto;
	}

	public int getIdLoja() {
		return idLoja;
	}

	public void setIdLoja(int idLoja) {
		this.idLoja = idLoja;
	}

	public String getDsListaObjeto() {
		return dsListaObjeto;
	}

	public void setDsListaObjeto(String dsListaObjeto) {
		this.dsListaObjeto = dsListaObjeto;
	}

	public String getCampo1() {
		return campo1;
	}

	public void setCampo1(String campo1) {
		this.campo1 = campo1;
	}

	public String getCampo2() {
		return campo2;
	}

	public void setCampo2(String campo2) {
		this.campo2 = campo2;
	}

	public String getCampo3() {
		return campo3;
	}

	public void setCampo3(String campo3) {
		this.campo3 = campo3;
	}

	public String getCampo4() {
		return campo4;
	}

	public void setCampo4(String campo4) {
		this.campo4 = campo4;
	}

	public String getStatus() {
		return status;
	}

	public void setStatus(String status) {
		this.status = status;
	}
}