package afero.model;

public class EstadoCivil {

	private int cdEstadoCivil;
	private String dsEstadoCivil;
	private String status;

	public EstadoCivil() {

	}

	public EstadoCivil(int cdEstadoCivil, String dsEstadoCivil, String status) {
		this.cdEstadoCivil = cdEstadoCivil;
		this.dsEstadoCivil = dsEstadoCivil;
		this.status = status;
	}

	public final int getCdEstadoCivil() {
		return cdEstadoCivil;
	}

	public final void setCdEstadoCivil(int cdEstadoCivil) {
		this.cdEstadoCivil = cdEstadoCivil;
	}

	public final String getDsEstadoCivil() {
		return dsEstadoCivil;
	}

	public final void setDsEstadoCivil(String dsEstadoCivil) {
		this.dsEstadoCivil = dsEstadoCivil;
	}

	public final String getStatus() {
		return status;
	}

	public final void setStatus(String status) {
		this.status = status;
	}
		
}
