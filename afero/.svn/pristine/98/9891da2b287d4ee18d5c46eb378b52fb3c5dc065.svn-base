package afero.model;

public class Ncm {
	
	private String cdNcm;
	private String dsNcm;
	
	
	public Ncm() {
		
	}
	public Ncm(String cdNcm, String dsNcm) {
		
		this.cdNcm = cdNcm;
		this.dsNcm = dsNcm;
	}
	public String getCdNcm() {
		return cdNcm;
	}
	public void setCdNcm(String cdNcm) {
		this.cdNcm = cdNcm;
	}
	public String getDsNcm() {
		return dsNcm;
	}
	public void setDsNcm(String dsNcm) {
		this.dsNcm = dsNcm;
	}
	
	

}
