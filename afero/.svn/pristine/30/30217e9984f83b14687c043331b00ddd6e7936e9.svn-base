<html>
<head>
<%@page contentType="text/html;charset=ISO-8859-1" pageEncoding="ISO-8859-1" %>
<%@page import="afero.model.Agrupamento"%>
<%@page import="afero.util.Utilitaria"%>
<%@page import="afero.persistence.AgrupamentoDAO"%>
<%@page import="afero.util.ConverteDate"%>
<%@include file="../seguranca.jsp"%>
<%@include file="../iniConexao.jsp"%>
<link type="text/css" rel="Stylesheet" href="../css/afero.css" />
<script src="../js/common.js"/>"</script>

<script>
function salvar() {
    if(document.all.dsAgrupamento.value == ''){
   	window.alert("O campo Descrição do Agrupamento é obrigatório.");
    	document.all.dsAgrupamento.focus();
    }else{
     document.forms[0].submit();
   }
}

function cancelar() {
  document.forms[0].action="formAgrupamento.jsp";
  document.forms[0].submit();
}

function voltar() {
  document.forms[0].action = 'listarAgrupamento.jsp?acao=voltar';
	document.forms[0].submit();
}
</script>
</head>
<%

String acao = request.getParameter("acao");
String idAgrupamento = request.getParameter("idAgrupamento");
ConverteDate converte = new ConverteDate();
if (acao == null) acao = "inc";
if (idAgrupamento == null) idAgrupamento = "";
String dsAgrupamento = "";
String status = "A";

//verifica se acao foi atualizar
if (acao.equalsIgnoreCase("atu")) {
  AgrupamentoDAO dao = new AgrupamentoDAO(conn);
  Agrupamento agrupamento = dao.procurarAgrupamento(Integer.parseInt(idAgrupamento));
  dsAgrupamento  = agrupamento.getDsAgrupamento();
  status = agrupamento.getStatus();
}
%>
<body onload="document.forms[0].elements[2].focus();" >
<h1 class="cabecalho_pagina">Cadastro de Agrupamento</h1>
<form method="post" action="listarAgrupamento.jsp?acao=<%=acao%>&idAgrupamento=<%=idAgrupamento%>">
<input type="hidden" name="acao" value="<%=acao%>"/>
<input type="hidden" name="idAgrupamento" value="<%=idAgrupamento%>"/>


<table border="0" width="100%">
  <tr>
    <th class="label">Descricao do Agrupamento*</th>
    <td><input type="text" name="dsAgrupamento" <%if (dsAgrupamento != null) { %>value="<%=dsAgrupamento%>"<% }%>  size="40" maxlength="40"></td>
  </tr>
  <tr>
    <th class="label">Ativo</th>
      <td class="label_radio"><input type="radio" class="radio" name="status" value="A" <%= (status.equals("A")? "checked": "") %>>Sim
      <input type="radio" class="radio" name="status" value="I" <%= (status.equals("I")? "checked": "") %>>Não</td>
  </tr>
</table><hr>
<table width="100%" border="0" cellpadding="0" cellspacing="0">
<tr>
	<td><input class="button" type="button" value="Salvar" onClick="javascript: salvar();" />
	<input class="button" type="button" value="Cancelar" onClick="javascript: cancelar();" />
	<input class="button" type="button" value="Voltar" onClick="javascript: voltar();" /></td>
	<td class="campo_obrigatorio">* Campos Obrigatórios</td>
</tr>
</table>
</form>
<%@include file="../fimConexao.jsp"%>

</body>
</html>