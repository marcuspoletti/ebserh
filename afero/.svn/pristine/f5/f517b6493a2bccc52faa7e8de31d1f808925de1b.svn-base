	font-family: Verdana, Geneva, Arial, Helvetica, sans-serif;
	font-size: 9pt;
	color: Black;
	border: none;
	text-align: left;
}
function Impressao(pedido){
  location.href="impPedido.jsp?impressao=ok&idPedidoSaida="+pedido;
  window.print();
}
