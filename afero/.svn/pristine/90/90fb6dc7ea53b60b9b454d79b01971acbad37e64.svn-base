package afero.model;

import java.util.Date;

public class Preco {
	
	private int idPreco;
	private int idEstoque;
	private int idUnidade;
	private Date dtInicioPreco;
	private Date dtFimPreco;
	private float preco;
	private float custoDireto;
	private float custoReal;
	private float custoMedioGeral;
	private float ultimoCustoCompra;
	private String usuario;
	private String precoPadrao;
	
	
	public Preco(){}
	
	public Preco(int idPreco, int idEstoque, int idUnidade, Date dtInicioPreco,
			Date dtFimPreco, float preco, float custoDireto, float custoReal,
			float custoMedioGeral, String usuario) {
		
		this.idPreco = idPreco;
		this.idEstoque = idEstoque;
		this.idUnidade = idUnidade;
		this.dtInicioPreco = dtInicioPreco;
		this.dtFimPreco = dtFimPreco;
		this.preco = preco;
		this.custoDireto = custoDireto;
		this.custoReal = custoReal;
		this.custoMedioGeral = custoMedioGeral;
		this.usuario = usuario;
	}
	public Preco(int idPreco, int idEstoque, int idUnidade, Date dtInicioPreco,
			Date dtFimPreco, float preco, float custoDireto, float custoReal,
			float custoMedioGeral, String usuario, String precoPadrao) {
		
		this.idPreco = idPreco;
		this.idEstoque = idEstoque;
		this.idUnidade = idUnidade;
		this.dtInicioPreco = dtInicioPreco;
		this.dtFimPreco = dtFimPreco;
		this.preco = preco;
		this.custoDireto = custoDireto;
		this.custoReal = custoReal;
		this.custoMedioGeral = custoMedioGeral;
		this.usuario = usuario;
		this.precoPadrao = precoPadrao;
	}
	
	

	public Preco(int idPreco, int idEstoque, int idUnidade, Date dtInicioPreco,
			Date dtFimPreco, float preco, float custoDireto, float custoReal,
			float custoMedioGeral, float ultimoCustoCompra, String usuario) {
		
		this.idPreco = idPreco;
		this.idEstoque = idEstoque;
		this.idUnidade = idUnidade;
		this.dtInicioPreco = dtInicioPreco;
		this.dtFimPreco = dtFimPreco;
		this.preco = preco;
		this.custoDireto = custoDireto;
		this.custoReal = custoReal;
		this.custoMedioGeral = custoMedioGeral;
		this.ultimoCustoCompra = ultimoCustoCompra;
		this.usuario = usuario;
	}

	public float getUltimoCustoCompra() {
		return ultimoCustoCompra;
	}

	public void setUltimoCustoCompra(float ultimoCustoCompra) {
		this.ultimoCustoCompra = ultimoCustoCompra;
	}

	public String getPrecoPadrao() {
		return precoPadrao;
	}

	public void setPrecoPadrao(String precoPadrao) {
		this.precoPadrao = precoPadrao;
	}

	public int getIdPreco() {
		return idPreco;
	}
	public void setIdPreco(int idPreco) {
		this.idPreco = idPreco;
	}
	public int getIdEstoque() {
		return idEstoque;
	}
	public void setIdEstoque(int idEstoque) {
		this.idEstoque = idEstoque;
	}
	public int getIdUnidade() {
		return idUnidade;
	}
	public void setIdUnidade(int idUnidade) {
		this.idUnidade = idUnidade;
	}
	public Date getDtInicioPreco() {
		return dtInicioPreco;
	}
	public void setDtInicioPreco(Date dtInicioPreco) {
		this.dtInicioPreco = dtInicioPreco;
	}
	public Date getDtFimPreco() {
		return dtFimPreco;
	}
	public void setDtFimPreco(Date dtFimPreco) {
		this.dtFimPreco = dtFimPreco;
	}
	public float getPreco() {
		return preco;
	}
	public void setPreco(float preco) {
		this.preco = preco;
	}
	public String getUsuario() {
		return usuario;
	}
	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}
	public float getCustoDireto() {
		return custoDireto;
	}
	public void setCustoDireto(float custoDireto) {
		this.custoDireto = custoDireto;
	}
	public float getCustoReal() {
		return custoReal;
	}
	public void setCustoReal(float custoReal) {
		this.custoReal = custoReal;
	}
	public float getCustoMedioGeral() {
		return custoMedioGeral;
	}
	public void setCustoMedioGeral(float custoMedioGeral) {
		this.custoMedioGeral = custoMedioGeral;
	}
	
	
	

}
