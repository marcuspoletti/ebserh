package afero.model;

import java.util.Date;

public class Entidade {

	private int cdEntidade;
	private String nome;
	private String tpInsc;
	private String site;
	private String status;
	private String observacao;
	private String bloqueio;
	private Date dtMod;
	private Date dtCad;
	private String usuario;

	public Entidade() {

	}

	public Entidade(int cdEntidade, String nome, String tpInsc,
			String site, String status, String observacao, String bloqueio, 
			Date dtMod, Date dtCad, String usuario) {
		this.cdEntidade = cdEntidade;
		this.nome = nome;
		this.tpInsc = tpInsc;
		this.site = site;
		this.status = status;
		this.observacao = observacao;
		this.bloqueio = bloqueio;
		this.dtMod = dtMod;
		this.dtCad = dtCad;
		this.usuario = usuario;
	}

	public final int getCdEntidade() {
		return cdEntidade;
	}

	public final void setCdEntidade(int cdEntidade) {
		this.cdEntidade = cdEntidade;
	}

	public final String getNome() {
		return nome;
	}

	public final void setNome(String nome) {
		this.nome = nome;
	}

	public final String getTpInsc() {
		return tpInsc;
	}

	public final void setTpInsc(String tpInsc) {
		this.tpInsc = tpInsc;
	}

	public final String getSite() {
		return site;
	}

	public final void setSite(String site) {
		this.site = site;
	}

	public final String getStatus() {
		return status;
	}

	public final void setStatus(String status) {
		this.status = status;
	}

	public final String getObservacao() {
		return observacao;
	}

	public final void setObservacao(String observacao) {
		this.observacao = observacao;
	}

	public final String getBloqueio() {
		return bloqueio;
	}

	public final void setBloqueio(String bloqueio) {
		this.bloqueio = bloqueio;
	}

	public final Date getDtMod() {
		return dtMod;
	}

	public final void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}

	public final Date getDtCad() {
		return dtCad;
	}

	public final void setDtCad(Date dtCad) {
		this.dtCad = dtCad;
	}

	public final String getUsuario() {
		return usuario;
	}

	public final void setUsuario(String usuario) {
		this.usuario = usuario;
	}

}
