package afero.model;

import java.util.Date;

public class OrcamentoSub {

	private int idOrcamento;
	private int idLoja;
	private int cdEntidade;
	private int idEntrega;
	private int idColaborador;
	private Date dtOrc;
	private Date dtEntrega;
	private String pessoaResponsavel;
	private double vlOrc;
	private int prazoValidade;
	private float vlDesc;
	private String observacao;
	private String status;
	private double vlAprov;
	private Date dtAprov;
	private int idOrdemServico;
	private int cdCondPagto;
	private int prazoEntrega;
	private int prazoGarantia;
	private String cmpOc1;
	private String cmpOc2;
	private String cmpOc3;
	private String cmpOc4;
	private Date dtMod;
	private String usuario;

	public OrcamentoSub() {
	}

	
	public OrcamentoSub(int idOrcamento, int idLoja, int cdEntidade,
			int idEntrega, int idColaborador, Date dtOrc, Date dtEntrega,
			String pessoaResponsavel, double vlOrc, int prazoValidade,
			float vlDesc, String observacao, String status, double vlAprov,
			Date dtAprov, int idOrdemServico, int cdCondPagto,
			int prazoEntrega, int prazoGarantia, String cmpOc1, String cmpOc2,
			String cmpOc3, String cmpOc4, Date dtMod, String usuario) {
		super();
		this.idOrcamento = idOrcamento;
		this.idLoja = idLoja;
		this.cdEntidade = cdEntidade;
		this.idEntrega = idEntrega;
		this.idColaborador = idColaborador;
		this.dtOrc = dtOrc;
		this.dtEntrega = dtEntrega;
		this.pessoaResponsavel = pessoaResponsavel;
		this.vlOrc = vlOrc;
		this.prazoValidade = prazoValidade;
		this.vlDesc = vlDesc;
		this.observacao = observacao;
		this.status = status;
		this.vlAprov = vlAprov;
		this.dtAprov = dtAprov;
		this.idOrdemServico = idOrdemServico;
		this.cdCondPagto = cdCondPagto;
		this.prazoEntrega = prazoEntrega;
		this.prazoGarantia = prazoGarantia;
		this.cmpOc1 = cmpOc1;
		this.cmpOc2 = cmpOc2;
		this.cmpOc3 = cmpOc3;
		this.cmpOc4 = cmpOc4;
		this.dtMod = dtMod;
		this.usuario = usuario;
	}


	public int getIdOrcamento() {
		return idOrcamento;
	}


	public void setIdOrcamento(int idOrcamento) {
		this.idOrcamento = idOrcamento;
	}


	public int getIdLoja() {
		return idLoja;
	}


	public void setIdLoja(int idLoja) {
		this.idLoja = idLoja;
	}


	public int getCdEntidade() {
		return cdEntidade;
	}


	public void setCdEntidade(int cdEntidade) {
		this.cdEntidade = cdEntidade;
	}


	public int getIdEntrega() {
		return idEntrega;
	}


	public void setIdEntrega(int idEntrega) {
		this.idEntrega = idEntrega;
	}


	public int getIdColaborador() {
		return idColaborador;
	}


	public void setIdColaborador(int idColaborador) {
		this.idColaborador = idColaborador;
	}


	public Date getDtOrc() {
		return dtOrc;
	}


	public void setDtOrc(Date dtOrc) {
		this.dtOrc = dtOrc;
	}


	public Date getDtEntrega() {
		return dtEntrega;
	}


	public void setDtEntrega(Date dtEntrega) {
		this.dtEntrega = dtEntrega;
	}


	public String getPessoaResponsavel() {
		return pessoaResponsavel;
	}


	public void setPessoaResponsavel(String pessoaResponsavel) {
		this.pessoaResponsavel = pessoaResponsavel;
	}


	public double getVlOrc() {
		return vlOrc;
	}


	public void setVlOrc(double vlOrc) {
		this.vlOrc = vlOrc;
	}


	public int getPrazoValidade() {
		return prazoValidade;
	}


	public void setPrazoValidade(int prazoValidade) {
		this.prazoValidade = prazoValidade;
	}


	public float getVlDesc() {
		return vlDesc;
	}


	public void setVlDesc(float vlDesc) {
		this.vlDesc = vlDesc;
	}


	public String getObservacao() {
		return observacao;
	}


	public void setObservacao(String observacao) {
		this.observacao = observacao;
	}


	public String getStatus() {
		return status;
	}


	public void setStatus(String status) {
		this.status = status;
	}


	public double getVlAprov() {
		return vlAprov;
	}


	public void setVlAprov(double vlAprov) {
		this.vlAprov = vlAprov;
	}


	public Date getDtAprov() {
		return dtAprov;
	}


	public void setDtAprov(Date dtAprov) {
		this.dtAprov = dtAprov;
	}


	public int getIdOrdemServico() {
		return idOrdemServico;
	}


	public void setIdOrdemServico(int idOrdemServico) {
		this.idOrdemServico = idOrdemServico;
	}


	public int getCdCondPagto() {
		return cdCondPagto;
	}


	public void setCdCondPagto(int cdCondPagto) {
		this.cdCondPagto = cdCondPagto;
	}


	public int getPrazoEntrega() {
		return prazoEntrega;
	}


	public void setPrazoEntrega(int prazoEntrega) {
		this.prazoEntrega = prazoEntrega;
	}


	public int getPrazoGarantia() {
		return prazoGarantia;
	}


	public void setPrazoGarantia(int prazoGarantia) {
		this.prazoGarantia = prazoGarantia;
	}


	public String getCmpOc1() {
		return cmpOc1;
	}


	public void setCmpOc1(String cmpOc1) {
		this.cmpOc1 = cmpOc1;
	}


	public String getCmpOc2() {
		return cmpOc2;
	}


	public void setCmpOc2(String cmpOc2) {
		this.cmpOc2 = cmpOc2;
	}


	public String getCmpOc3() {
		return cmpOc3;
	}


	public void setCmpOc3(String cmpOc3) {
		this.cmpOc3 = cmpOc3;
	}


	public String getCmpOc4() {
		return cmpOc4;
	}


	public void setCmpOc4(String cmpOc4) {
		this.cmpOc4 = cmpOc4;
	}


	public Date getDtMod() {
		return dtMod;
	}


	public void setDtMod(Date dtMod) {
		this.dtMod = dtMod;
	}


	public String getUsuario() {
		return usuario;
	}


	public void setUsuario(String usuario) {
		this.usuario = usuario;
	}
	
}
