package afero.persistence;

import java.util.List;

import afero.model.EntidadeEndereco;

public interface IEntidadeEnderecoDAO {
	
	public void incluir(EntidadeEndereco entidadeEndereco) throws AferoDAOException;

	public void atualizar(EntidadeEndereco entidadeEndereco) throws AferoDAOException;

	public void excluir(EntidadeEndereco entidadeEndereco) throws AferoDAOException;

	public EntidadeEndereco procurarEntidadeEndereco(int idEntidadeEndereco) throws AferoDAOException;

	public List<EntidadeEndereco> listarEntidadeEndereco(String clausula) throws AferoDAOException;

}
