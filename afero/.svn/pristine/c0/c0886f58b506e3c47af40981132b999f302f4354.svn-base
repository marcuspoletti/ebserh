package afero.persistence;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;

import afero.model.OrdemServicoObjeto;
import afero.util.ConverteDate;

public class OrdemServicoObjetoDAO {
	
	public Connection conn;

	public OrdemServicoObjetoDAO(Connection conn) {
		this.conn = conn;
	}

	// INSERIR
	
	public void incluir(OrdemServicoObjeto ordemServicoObjeto) throws AferoDAOException {
		PreparedStatement ps = null;
		Connection conn = null;
		if (ordemServicoObjeto == null)
			throw new AferoDAOException("O valor passado não pode ser nulo");
		
		try {
			String sql = " INSERT INTO tbordemservicoObjeto (idOrdemServico, idListaObjeto, campo1, campo2, campo3, campo4, observacao, dtGarantia, nrControle, " +
						" dtMod, usuario) " +
						" VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, now(), ? ) ";
			
			conn = this.conn;
			ps = conn.prepareStatement(sql);
			ps.setInt(1, ordemServicoObjeto.getIdOrdemServico());
			ps.setInt(2, ordemServicoObjeto.getIdListaObjeto());
			ps.setString(3, ordemServicoObjeto.getCampo1());
			ps.setString(4, ordemServicoObjeto.getCampo2());
			ps.setString(5, ordemServicoObjeto.getCampo3());
			ps.setString(6, ordemServicoObjeto.getCampo4());
			ps.setString(7, ordemServicoObjeto.getObservacao());
			ps.setDate(8, ConverteDate.DateToDateSql(ordemServicoObjeto.getDtGarantia()));
			ps.setInt(9, ordemServicoObjeto.getNrControle());
			ps.setString(10, ordemServicoObjeto.getUsuario());
			
			ps.executeUpdate();

		} catch (SQLException sqle) {
			throw new AferoDAOException("Erro ao inserir dados: " + sqle);
		} catch (Exception e) {
			throw new AferoDAOException("Erro ao inserir dados: " + e);
		} finally {
			// ConnectionFactory.closeConnection(conn, ps);
		}
	}

	// ATUALIZAR 
	
	public void atualiza(OrdemServicoObjeto ordemServicoObjeto) throws AferoDAOException {
		PreparedStatement ps = null;
		Connection conn = null;
		if (ordemServicoObjeto == null)
			throw new AferoDAOException("O valor passado não pode ser nulo");
		
		try {
			String sql = "UPDATE tbOrdemServicoObjeto set idOrdemServico = ?, idListaObjeto = ?, campo1 = ?, campo2 = ?, campo3 = ?," +
						"campo4 = ?, observacao = ?, dtGarantia = ?, nrControle = ?, dtMod = now(), usuario = ?" +
						"WHERE idOrdemServicoObjeto = ?";
			
			conn = this.conn;
			ps = conn.prepareStatement(sql);
			ps.setInt(1, ordemServicoObjeto.getIdOrdemServico());
			ps.setInt(2, ordemServicoObjeto.getIdListaObjeto());
			ps.setString(3, ordemServicoObjeto.getCampo1());
			ps.setString(4, ordemServicoObjeto.getCampo2());
			ps.setString(5, ordemServicoObjeto.getCampo3());
			ps.setString(6, ordemServicoObjeto.getCampo4());
			ps.setString(7, ordemServicoObjeto.getObservacao());
			ps.setDate(8, ConverteDate.DateToDateSql(ordemServicoObjeto.getDtGarantia()));
			ps.setInt(9, ordemServicoObjeto.getNrControle());
			ps.setString(10, ordemServicoObjeto.getUsuario());
			ps.setInt(11, ordemServicoObjeto.getIdOrdemServicoObjeto());

			ps.executeUpdate();

		} catch (SQLException sqle) {
			throw new AferoDAOException("Erro ao atualizar dados: " + sqle);
		} catch (Exception e) {
			throw new AferoDAOException("Erro ao atualizar dados: " + e);
		} finally {
			// ConnectionFactory.closeConnection(conn, ps);
		}
	}
	
	// EXCLUIR
	public void excluir(OrdemServicoObjeto ordemServicoObjeto) throws AferoDAOException {
		PreparedStatement ps = null;
		Connection conn = null;
		if (ordemServicoObjeto == null)
			throw new AferoDAOException("O valor passado não pode ser nulo");

		try {
			conn = this.conn;
			ps = conn.prepareStatement(" DELETE FROM tbOrdemServicoObjeto WHERE idOrdemServicoObjeto = ? ");
			ps.setInt(1, ordemServicoObjeto.getIdOrdemServicoObjeto());
			ps.executeUpdate();

		} catch (SQLException sqle) {
			throw new AferoDAOException("Erro ao excluir dados:" + sqle);
		} finally {
			// ConnectionFactory.closeConnection(conn, ps);
		}
	}
	
	// BUSCAR
	
	public OrdemServicoObjeto procurarOrdemServicoObjeto (String clausula) throws AferoDAOException {
		PreparedStatement ps = null;
		Connection conn = null;
		ResultSet rs = null;
		OrdemServicoObjeto ordemServicoObjeto = null;
		
		try {
			String sql = "SELECT idOrdemServicoObjeto, idOrdemServico, idListaObjeto, campo1, campo2, campo3, campo4, observacao, " +
						"dtGarantia, nrControle, dtMod, usuario " +
						" FROM tbOrdemServicoObjeto";
			
			if(clausula != null)
				sql += clausula;
			conn = this.conn;
			ps = conn.prepareStatement(sql);
			rs = ps.executeQuery();
			while (rs.next()) {
				
				ordemServicoObjeto = new OrdemServicoObjeto();
				
				ordemServicoObjeto.setIdOrdemServicoObjeto(rs.getInt(1));
				ordemServicoObjeto.setIdOrdemServico(rs.getInt(2));
				ordemServicoObjeto.setIdListaObjeto(rs.getInt(3));
				ordemServicoObjeto.setCampo1(rs.getString(4));
				ordemServicoObjeto.setCampo2(rs.getString(5));
				ordemServicoObjeto.setCampo3(rs.getString(6));
				ordemServicoObjeto.setCampo4(rs.getString(7));
				ordemServicoObjeto.setObservacao(rs.getString(8));
				ordemServicoObjeto.setDtGarantia(rs.getDate(9));
				ordemServicoObjeto.setNrControle(rs.getInt(10));
				ordemServicoObjeto.setDtMod(rs.getDate(11));
				ordemServicoObjeto.setUsuario(rs.getString(12));	

			}
		} catch (SQLException sqle) {
			throw new AferoDAOException("Erro ao procurar dados:" + sqle);
		}catch (Exception e){
			throw new AferoDAOException ("Erro ao procurar dados:" + e);
		} finally {
			// ConnectionFactory.closeConnection(conn, ps);
		}
		return ordemServicoObjeto;
	}
	
	// LISTAR
	
	public List<OrdemServicoObjeto> listar(String clausula) throws AferoDAOException {
		PreparedStatement ps = null;
		Connection conn = null;
		ResultSet rs = null;
		List<OrdemServicoObjeto> list = new ArrayList<OrdemServicoObjeto>();

		try {
			String sql = "SELECT idOrdemServicoObjeto, idOrdemServico, idListaObjeto, campo1, campo2, campo3, campo4, observacao, " +
						"dtGarantia, nrControle, dtMod, usuario " +
						"FROM tbOrdemServicoObjeto";
			
			if (clausula != null)
				sql += clausula;
			
			conn = this.conn;
			ps = conn.prepareStatement(sql);
			rs = ps.executeQuery();
			
			while (rs.next()){
				
				int idOrdemServicoObjeto = rs.getInt(1);
				int idOrdemServico = rs.getInt(2);
				int idListaObjeto = rs.getInt(3);
				String campo1 = rs.getString(4);
				String campo2 = rs.getString(5);
				String campo3 = rs.getString(6);
				String campo4 = rs.getString(7);
				String observacao = rs.getString(8);
				Date dtGarantia = rs.getDate(9);
				int nrControle = rs.getInt(10);
				Date dtMod = rs.getDate(11);
				String usuario = rs.getString(12);
				
				list.add( new OrdemServicoObjeto(idOrdemServicoObjeto, idOrdemServico, idListaObjeto, campo1, campo2, campo3,
						campo4, observacao, dtGarantia, nrControle, dtMod, usuario));
				
			}

		} catch (SQLException sqle) {
			throw new AferoDAOException("Erro ao listar dados: " + sqle);
		} catch (Exception e) {
			throw new AferoDAOException("Erro ao listar dados: " + e);
		} finally {
			// ConnectionFactory.closeConnection(conn, ps);
		}
		return list;
	}
}