<%@page import ="afero.model.Colaborador" %>
<%@page import ="afero.persistence.ColaboradorDAO" %>
<%@ page import="java.util.List" %>
<%@ page import="java.util.Iterator" %>
<%
ColaboradorDAO daoColaboradorContaMovto;
List listColaborador;
daoColaboradorContaMovto = new ColaboradorDAO(conn);
String clausulaColaborador = "  WHERE status='A' ORDER BY apelido";
listColaborador = daoColaboradorContaMovto.listarColaborador(clausulaColaborador);
Iterator itColaboradorContaMovto = listColaborador.iterator();
while (itColaboradorContaMovto.hasNext()) { 
	Colaborador listarColaboradorContaMovto = (Colaborador) itColaboradorContaMovto.next();
%>

<option value="<%=listarColaboradorContaMovto.getIdColaborador()%>"><%=listarColaboradorContaMovto.getApelido()%>/<%=listarColaboradorContaMovto.getNome()%></option>
<%
}
%>